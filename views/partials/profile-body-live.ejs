<%# Everything under the player card. Also the live refresh's body. %>
<div class="pf-section">
  <div class="pf-title pf-title-purple">King of the court</div>
  <% if (kingRows.length === 0) { %>
    <div class="pf-empty">Play a game to start earning crowns</div>
  <% } else { %>
    <% kingRows.forEach((row) => { %>
      <div class="pf-king-row">
        <% if (row.crown) { %>
          <%- include('crown-icon', { size: 26, fill: row.crown.fill, stroke: row.crown.stroke }) %>
        <% } else { %>
          <%- include('crown-icon', { size: 26, fill: 'none', stroke: '#8A8F98' }) %>
        <% } %>
        <span class="pf-king-format"><%= row.format %></span>
        <span class="pf-king-level"><%= row.crown ? row.crown.name : 'Not yet a crown' %></span>
        <span class="pf-king-points"><%= row.points %> pts</span>
      </div>
    <% }); %>
  <% } %>
</div>

<div class="pf-stats">
  <div class="pf-stat">
    <div class="pf-stat-title">Trophies</div>
    <div class="pf-stat-number"><%= trophyCount %></div>
    <div class="pf-stat-sub">
      <% if (trophyByFormat.length === 0) { %>
        None yet
      <% } else { %>
        <% trophyByFormat.forEach((t) => { %><span class="pf-trophy-format"><%= t.format %> · <%= t.n %></span><% }); %>
      <% } %>
    </div>
  </div>
  <div class="pf-stat">
    <div class="pf-stat-title">Games</div>
    <div class="pf-stat-number"><%= gamesThisSeason %></div>
    <div class="pf-stat-sub">this month</div>
  </div>
</div>

<% if (topBreakdown) { %>
  <div class="pf-section">
    <div class="pf-title"><%= topBreakdown.format %> points this month</div>
    <div class="pf-breakdown">
      <div class="pf-row"><span>Wins <%= topBreakdown.wins %> × 3</span><span class="pf-val"><%= topBreakdown.winPoints %></span></div>
      <div class="pf-row"><span>Games played <%= topBreakdown.games %> × 1</span><span class="pf-val"><%= topBreakdown.games %></span></div>
      <div class="pf-row"><span>Court hours <%= topBreakdown.hours %> × 1</span><span class="pf-val"><%= topBreakdown.hours %></span></div>
      <div class="pf-divider"></div>
      <div class="pf-row pf-total"><span>Total</span><span class="pf-val"><%= topBreakdown.total %></span></div>
    </div>
  </div>
<% } %>

<div class="pf-section">
  <div class="pf-title">Badges</div>
  <div class="pf-badges">
    <% badges.forEach((label) => { %>
      <div class="pf-badge-cell">
        <div class="pf-badge">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#8A8F98" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
        </div>
        <div class="pf-badge-label"><%= label %></div>
      </div>
    <% }); %>
  </div>
</div>
