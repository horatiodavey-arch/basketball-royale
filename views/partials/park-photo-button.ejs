<%# The camera button (wired up by /park-photo.js). Players at the park get
    the camera straight away; an organizer, who may be adding a photo from
    somewhere else, gets the phone's picker so an existing one can be used. %>
<span class="park-photo-add" data-park-id="<%= parkId %>" data-can-add="<%= canAdd ? '1' : '0' %>" data-status-id="<%= statusId %>">
  <button type="button" class="camera-btn" aria-label="Add a photo of this park" title="Add a photo of this park">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8h3l2-3h6l2 3h3a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1z"/><circle cx="12" cy="13" r="3.5"/></svg>
  </button>
  <input type="file" accept="image/*" <%- isOrganizer ? '' : 'capture="environment"' %> hidden>
</span>
