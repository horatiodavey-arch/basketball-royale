<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= park.name %> — Basketball Royale</title>
<%- include('partials/fonts') %>
<link rel="stylesheet" href="/style.css">
</head>
<body class="kotc">
<div class="page">
  <div class="page-title heading"><%= park.name %></div>
  <% if (park.added_by_name) { %>
    <div class="page-sub">Court added by <%= park.added_by_name %></div>
  <% } %>

  <% if (error) { %>
    <div class="error-msg"><%= error %></div>
  <% } %>

  <div class="checkin-row">
    <% if (checkedIn) { %>
      <span class="checkin-pill checkin-pill-in">Checked in</span>
    <% } else { %>
      <div id="checkInNormal">
        <button type="button" id="checkInBtn" class="checkin-pill checkin-pill-out">Check in</button>
        <span id="checkInStatus" class="checkin-status"></span>
      </div>
      <div id="checkInTooFar" class="too-far-box" style="display: none;">
        <div class="too-far-msg" id="tooFarMsg"></div>
        <% if (upcomingRuns.length > 0) { %>
          <form method="POST" action="/runs/<%= upcomingRuns[0].id %>/coming" style="margin-top: 8px;">
            <button type="submit" class="small-btn">I'm coming</button>
          </form>
        <% } %>
      </div>
    <% } %>
  </div>

  <div class="court-actions-row">
    <a href="/runs/new?courtId=<%= court.id %>" class="small-btn link-btn">Start run</a>
    <form method="POST" action="/courts/<%= court.id %>/follow">
      <button type="submit" class="small-btn <%= isFollowing ? 'small-btn-accent' : '' %>"><%= isFollowing ? 'Following ✓' : 'Follow' %></button>
    </form>
  </div>

  <% if (upcomingRuns.length > 0) { %>
    <div class="section">Upcoming runs</div>
    <% upcomingRuns.forEach((run) => { %>
      <a href="/runs/<%= run.id %>" class="park-link run-card">
        <div class="park-link-name"><%= formatRunTime(run.scheduledAt) %></div>
        <div class="park-link-location"><%= run.rsvpCount %> coming<% if (run.note) { %> &middot; <%= run.note %><% } %></div>
      </a>
    <% }); %>
  <% } %>

  <div class="tabs court-tabs">
    <% courts.forEach((c) => { %>
      <a class="tab <%= c.id === court.id ? 'active' : '' %>" href="/parks/<%= park.id %>/courts/<%= c.id %>">
        <%= c.nickname || ('Court ' + c.number) %>
      </a>
    <% }); %>
  </div>

  <% if (liveGame) { %>
    <div class="live-card">
      <% if (liveGame.status === 'countdown') { %>
        <div class="countdown-label">Next game in</div>
        <div id="countdown" class="countdown-big heading">&ndash;:&ndash;&ndash;</div>
      <% } else { %>
        <div class="live-target">to <%= liveGame.target %></div>
      <% } %>

      <div class="live-teams">
        <div class="live-team">
          <div class="live-team-label">Team A</div>
          <% liveGame.teamA.forEach((p) => { %>
            <div class="live-player"><%= p.name %><% if (p.captain) { %> <span class="cap-tag">C</span><% } %></div>
          <% }); %>
          <% if (liveGame.teamA.length === 0) { %><div class="live-player live-player-empty">&mdash;</div><% } %>
        </div>
        <div class="live-vs">vs</div>
        <div class="live-team">
          <div class="live-team-label">Team B</div>
          <% liveGame.teamB.forEach((p) => { %>
            <div class="live-player"><%= p.name %><% if (p.captain) { %> <span class="cap-tag">C</span><% } %></div>
          <% }); %>
          <% if (liveGame.teamB.length === 0) { %><div class="live-player live-player-empty">Waiting for a squad&hellip;</div><% } %>
        </div>
      </div>

      <% if (liveGame.status === 'in_progress') { %>
        <div class="winners-note">Winners stay on</div>
        <% if (liveGame.viewerCaptainTeam) { %>
          <div class="declare-row">
            <form method="POST" action="/live_games/<%= liveGame.id %>/declare">
              <input type="hidden" name="team" value="a">
              <button type="submit" class="small-btn">Team A won</button>
            </form>
            <form method="POST" action="/live_games/<%= liveGame.id %>/declare">
              <input type="hidden" name="team" value="b">
              <button type="submit" class="small-btn">Team B won</button>
            </form>
          </div>
        <% } %>
      <% } else if (liveGame.status === 'awaiting_confirmation') { %>
        <% const declaringTeam = liveGame.team_a_won ? 'a' : 'b'; %>
        <div class="winners-note">Team <%= declaringTeam === 'a' ? 'A' : 'B' %> says they won</div>
        <% if (liveGame.viewerCaptainTeam && liveGame.viewerCaptainTeam !== declaringTeam) { %>
          <form method="POST" action="/live_games/<%= liveGame.id %>/confirm">
            <button type="submit" class="small-btn small-btn-accent">Confirm Team <%= declaringTeam === 'a' ? 'A' : 'B' %> won</button>
          </form>
        <% } else if (liveGame.viewerCaptainTeam) { %>
          <div class="winners-note">Waiting on the other captain to confirm.</div>
        <% } %>
      <% } %>

      <% if (liveGame.viewerCaptainTeam) { %>
        <details class="captain-tools">
          <summary>Captain tools</summary>
          <% [...liveGame.teamA, ...liveGame.teamB].filter((p) => p.team === liveGame.viewerCaptainTeam).forEach((p) => { %>
            <form method="POST" action="/live_games/<%= liveGame.id %>/left" class="inline-form">
              <input type="hidden" name="playerId" value="<%= p.playerId %>">
              <span><%= p.name %></span>
              <button type="submit" class="tiny-btn">Mark left</button>
            </form>
          <% }); %>
          <% if (availablePlayers.length > 0) { %>
            <form method="POST" action="/live_games/<%= liveGame.id %>/sub" class="inline-form">
              <input type="hidden" name="team" value="<%= liveGame.viewerCaptainTeam %>">
              <select name="playerId">
                <% availablePlayers.forEach((p) => { %><option value="<%= p.id %>"><%= p.name %></option><% }); %>
              </select>
              <button type="submit" class="tiny-btn">Add sub</button>
            </form>
          <% } %>
        </details>
      <% } %>
    </div>
  <% } else { %>
    <div class="live-card live-card-idle">Court is open &mdash; next two squads in line will start the next game.</div>
  <% } %>

  <div class="section">Next up on <%= court.nickname || ('Court ' + court.number) %></div>
  <% if (queue.length === 0) { %>
    <div class="empty-board">Nobody in line yet.</div>
  <% } %>
  <% queue.forEach((squad, i) => { %>
    <div class="queue-row">
      <div class="queue-rank"><%= i + 1 %></div>
      <div class="queue-main">
        <div class="queue-names"><%= squad.roster.map((p) => p.name).join(', ') %></div>
        <div class="queue-count"><%= squad.count %> of 5 picked<% if (squad.ready) { %> &middot; <span class="queue-ready">Ready</span><% } %></div>
      </div>
    </div>
  <% }); %>

  <% if (viewerPlaying) { %>
    <div class="next-action-note">You're on the court.</div>
  <% } else if (!checkedIn) { %>
    <div class="next-action-note">Check in at this park to get in line.</div>
  <% } else if (viewerSquad) { %>
    <% if (viewerIsCaptain && viewerSquad.count < 5) { %>
      <form method="POST" action="/next_line/<%= viewerSquad.id %>/members" class="pick-form">
        <div class="pick-form-title">Pick from who's here</div>
        <% const squadIds = new Set(viewerSquad.roster.map((p) => p.id)); %>
        <% availablePlayers.forEach((p) => { %>
          <label class="player-check">
            <input type="checkbox" name="playerIds" value="<%= p.id %>">
            <%= p.name %>
          </label>
        <% }); %>
        <% if (availablePlayers.length === 0) { %><div class="next-action-note">Nobody else checked in right now.</div><% } %>
        <button type="submit" class="submit-btn">Add to squad</button>
      </form>
    <% } else { %>
      <div class="next-action-note">You're in line &mdash; <%= viewerSquad.count %> of 5 picked<% if (viewerSquad.ready) { %> &middot; Ready<% } %>.</div>
    <% } %>
  <% } else { %>
    <form method="POST" action="/courts/<%= court.id %>/next">
      <button type="submit" class="submit-btn">I got next</button>
    </form>
  <% } %>

  <details class="settings-details">
    <summary>Game settings</summary>
    <form method="POST" action="/parks/<%= park.id %>/settings" class="settings-form">
      <div class="form-group">
        <label for="gameTarget">Game target</label>
        <input type="number" id="gameTarget" name="gameTarget" min="1" value="<%= park.game_target %>">
      </div>
      <div class="form-group">
        <label for="betweenGamesMinutes">Time between games (minutes)</label>
        <input type="number" id="betweenGamesMinutes" name="betweenGamesMinutes" min="1" value="<%= Math.round(park.between_games_seconds / 60) %>">
      </div>
      <div class="form-group">
        <label for="checkInRadiusMeters">Check-in radius (meters)</label>
        <input type="number" id="checkInRadiusMeters" name="checkInRadiusMeters" min="1" value="<%= park.check_in_radius_meters %>">
      </div>
      <div class="form-group">
        <label for="leaveRadiusMeters">Leave radius (meters)</label>
        <input type="number" id="leaveRadiusMeters" name="leaveRadiusMeters" min="1" value="<%= park.leave_radius_meters %>">
      </div>
      <button type="submit" class="small-btn">Save</button>
    </form>
  </details>

  <div class="season-note leave-note">Leave past <%= park.leave_radius_meters %>m for 5+ minutes and you lose your spot.</div>
</div>
<%- include('partials/bottom-nav', { active: 'runs' }) %>

<script>
  (function () {
    var parkId = <%= park.id %>;
    var checkedIn = <%= checkedIn ? 'true' : 'false' %>;

    function startHeartbeat() {
      setInterval(function () {
        if (!navigator.geolocation) return;
        navigator.geolocation.getCurrentPosition(function (pos) {
          fetch('/parks/' + parkId + '/heartbeat', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ lat: pos.coords.latitude, lng: pos.coords.longitude }),
          }).catch(function () {});
        }, function () {
          // Couldn't get a fresh position this cycle — skip; the "inside"
          // clock just won't be extended until the next successful one.
        });
      }, 60000);
    }

    var checkInBtn = document.getElementById('checkInBtn');
    if (checkInBtn) {
      checkInBtn.addEventListener('click', function () {
        var statusEl = document.getElementById('checkInStatus');
        if (!navigator.geolocation) {
          statusEl.textContent = 'Location not available on this device.';
          return;
        }
        checkInBtn.disabled = true;
        statusEl.textContent = 'Finding you…';
        navigator.geolocation.getCurrentPosition(function (pos) {
          fetch('/parks/' + parkId + '/check-in', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ lat: pos.coords.latitude, lng: pos.coords.longitude }),
          })
            .then(function (r) { return r.json(); })
            .then(function (data) {
              if (data.ok) {
                location.reload();
              } else {
                checkInBtn.disabled = false;
                statusEl.textContent = data.error || 'Could not check in.';
              }
            })
            .catch(function () {
              checkInBtn.disabled = false;
              statusEl.textContent = 'Could not check in.';
            });
        }, function () {
          checkInBtn.disabled = false;
          statusEl.textContent = 'Location permission denied.';
        });
      });
    } else if (checkedIn) {
      startHeartbeat();
    }

    // Proactively swap the Check-in button for a distance message when
    // we're confident the player is outside the radius — rather than
    // waiting for them to tap Check in and hit the server-side error.
    var parkLat = <%- park.lat != null ? park.lat : 'null' %>;
    var parkLng = <%- park.lng != null ? park.lng : 'null' %>;
    var checkInRadiusMeters = <%= park.check_in_radius_meters %>;
    if (checkInBtn && parkLat != null && navigator.geolocation) {
      navigator.geolocation.getCurrentPosition(function (pos) {
        var R = 3958.8;
        var toRad = function (d) { return (d * Math.PI) / 180; };
        var dLat = toRad(parkLat - pos.coords.latitude);
        var dLng = toRad(parkLng - pos.coords.longitude);
        var a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
          Math.cos(toRad(pos.coords.latitude)) * Math.cos(toRad(parkLat)) * Math.sin(dLng / 2) * Math.sin(dLng / 2);
        var miles = R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
        if (miles * 1609.34 > checkInRadiusMeters) {
          document.getElementById('checkInNormal').style.display = 'none';
          var tooFar = document.getElementById('checkInTooFar');
          document.getElementById('tooFarMsg').textContent =
            "You're " + miles.toFixed(1) + ' mi away. Check in opens when you get to the court.';
          tooFar.style.display = 'block';
        }
      }, function () {
        // Denied/unavailable — leave the normal Check in button as is;
        // tapping it still falls back to the server-side distance check.
      }, { timeout: 8000 });
    }

    var countdownEl = document.getElementById('countdown');
    if (countdownEl) {
      var endsAt = new Date('<%- countdownEndsAtIso %>').getTime();
      var tick = function () {
        var remaining = Math.max(0, Math.round((endsAt - Date.now()) / 1000));
        var m = Math.floor(remaining / 60);
        var s = remaining % 60;
        countdownEl.textContent = m + ':' + (s < 10 ? '0' : '') + s;
        if (remaining <= 0) {
          clearInterval(timer);
          setTimeout(function () { location.reload(); }, 1500);
        }
      };
      tick();
      var timer = setInterval(tick, 1000);
    }

    // Lightweight polling so other players' moves (someone else joins
    // the line, a game locks, a countdown resolves) show up without a
    // manual refresh.
    setInterval(function () { location.reload(); }, 15000);
  })();
</script>
</body>
</html>
