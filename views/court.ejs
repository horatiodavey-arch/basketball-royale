<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= park.name %> — Basketball Royale</title>
<%- include('partials/fonts') %>
<%- include('partials/pwa-head') %>
<link rel="stylesheet" href="/style.css">
</head>
<body class="kotc">
<div class="page">
  <%- include('partials/royale-header') %>

  <% if (park.cover_filename) { %>
    <img src="/park-photos/<%= park.cover_filename %>" alt="<%= park.name %>" class="park-cover">
  <% } else { %>
    <div class="park-cover-empty">No photo yet. Be the first to add one.</div>
  <% } %>

  <div class="park-title-row cs-title-row">
    <div class="page-title heading"><%- include('partials/park-name', { name: park.name, city: park.city }) %><% if (parkIsNew) { %><span class="new-badge">New</span><% } %></div>
    <div class="cs-title-tools">
      <%- include('partials/park-photo-button', { parkId: park.id, canAdd: canAddPhoto, isOrganizer: !!profile.is_organizer, statusId: 'parkPhotoStatus' }) %>
      <%- include('partials/court-sheet-top', { cs: cs }) %>
    </div>
  </div>
  <div class="cs-sub"><%= park.is_indoor ? 'Indoor' : 'Outdoor' %> &middot; <%= courts.length %> court<%= courts.length === 1 ? '' : 's' %></div>
  <div id="parkPhotoStatus" class="park-photo-status"></div>
  <div class="park-now">
    <% if (parkKing) { %>King of the Court: <span class="king-name-text"><%= parkKing.name %></span><% } else { %>No king yet. Be the first.<% } %>
    <% if (parkLive) { %><span class="live-badge">Live</span><% } %>
  </div>
  <% if (park.added_by_name) { %>
    <div class="page-sub">Court added by <%= park.added_by_name %></div>
  <% } %>

  <% if (error) { %>
    <div class="error-msg"><%= error %></div>
  <% } %>

  <%- include('partials/court-line', { cs: cs, showGames: false, ids: { btn: 'checkInBtn', normal: 'checkInNormal', tooFar: 'checkInTooFar', tooFarMsg: 'tooFarMsg', status: 'checkInStatus' } }) %>
  <% const firstRun = parkGames[0] || null; %>
  <% if (checkedIn) { %>
    <div class="cs-secondary">
      <% if (firstRun) { %><a href="/parks/<%= park.id %>/courts/<%= firstRun.courtId %>#live-<%= firstRun.id %>" class="run-cta-outline">Join this run</a><% } %>
      <a href="/parks/<%= park.id %>/start-game?court=<%= court.id %>" class="run-cta-outline"><%= firstRun ? 'Start your own game' : 'Start a game now' %></a>
    </div>
  <% } %>

  <% if (upcomingRuns.length > 0) { %>
    <div class="section">Upcoming runs</div>
    <% upcomingRuns.forEach((run) => { %>
      <a href="/runs/<%= run.id %>" class="park-link run-card">
        <div class="park-link-name"><%= formatRunTime(run.scheduledAt) %></div>
        <div class="park-link-location"><%= run.rsvpCount %> coming<% if (run.note) { %> &middot; <%= run.note %><% } %></div>
      </a>
    <% }); %>
  <% } %>

  <div class="tabs court-tabs">
    <% courts.forEach((c) => { %>
      <a class="tab <%= c.id === court.id ? 'active' : '' %>" href="/parks/<%= park.id %>/courts/<%= c.id %>">
        <%= c.nickname || ('Court ' + c.number) %>
      </a>
    <% }); %>
  </div>

  <% const gn = gameNow; %>
  <% if (gn.pending) { %>
    <% const p = gn.pending; %>
    <div class="live-card">
      <div class="live-target">Result waiting for confirmation</div>
      <div class="winners-note">Team <%= p.winner === 'a' ? 'A' : 'B' %> won. It counts once a player from the other team confirms.</div>
      <div class="live-teams">
        <div class="live-team">
          <div class="live-team-label">Team A</div>
          <% p.rosters.a.forEach((n) => { %><div class="live-player"><%= n %></div><% }); %>
        </div>
        <div class="live-vs">vs</div>
        <div class="live-team">
          <div class="live-team-label">Team B</div>
          <% p.rosters.b.forEach((n) => { %><div class="live-player"><%= n %></div><% }); %>
        </div>
      </div>
      <% if (p.viewerTeam && p.viewerTeam !== p.submittedTeam) { %>
        <div class="declare-row">
          <form method="POST" action="/live_games/<%= p.id %>/confirm">
            <button type="submit" class="small-btn small-btn-accent">Confirm</button>
          </form>
          <form method="POST" action="/live_games/<%= p.id %>/dispute">
            <button type="submit" class="small-btn">Dispute</button>
          </form>
        </div>
      <% } else if (p.viewerTeam) { %>
        <div class="winners-note">Waiting on a player from the other team to confirm.</div>
      <% } %>
      <div class="qr-share">
        <img src="<%= p.qr %>" alt="QR code to open this game" width="160" height="160">
        <button type="button" class="small-btn" data-share-url="<%= p.shareUrl %>">Send QR link</button>
      </div>
    </div>
  <% } %>
  <% if (liveGame) { %>
    <% const size = Number(String(liveGame.format || '0').charAt(0)); %>
    <% const onCount = liveGame.teamA.length + liveGame.teamB.length + gameGuests.a.length + gameGuests.b.length; %>
    <% const slots = size * 2; %>
    <% const openSpots = Math.max(0, slots - onCount); %>
    <% const thisRun = parkGames.find((g) => g.id === liveGame.id); %>
    <div class="live-card" id="live-<%= liveGame.id %>">
      <div class="live-target"><%= liveGame.format %> &middot; <%= court.nickname || ('Court ' + court.number) %> &middot; game on</div>
      <% if (thisRun) { %><div class="live-run-meta"><%= thisRun.onCount %> on &middot; <%= thisRun.nextCount %> <%= thisRun.nextCount === 1 ? 'team' : 'teams' %> next</div><% } %>
      <div class="live-count">On court: <%= onCount %> of <%= slots %> on the app, <%= openSpots %> open spots</div>

      <div class="live-teams">
        <div class="live-team">
          <div class="live-team-label">Team A</div>
          <% if (courtHeater && courtHeater.team === 'a') { %><div class="heater-tag<%= courtHeater.count >= 3 ? ' hot' : '' %>"><%= courtHeater.label %></div><% } %>
          <% liveGame.teamA.forEach((p) => { %>
            <div class="live-player"><%= p.name %></div>
          <% }); %>
          <% gameGuests.a.forEach((g) => { %><div class="live-player live-player-guest">Guest: <%= g.first_name %></div><% }); %>
          <% if (liveGame.teamA.length + gameGuests.a.length === 0) { %><div class="live-player live-player-empty">&mdash;</div><% } %>
        </div>
        <div class="live-vs">vs</div>
        <div class="live-team">
          <div class="live-team-label">Team B</div>
          <% if (courtHeater && courtHeater.team === 'b') { %><div class="heater-tag<%= courtHeater.count >= 3 ? ' hot' : '' %>"><%= courtHeater.label %></div><% } %>
          <% liveGame.teamB.forEach((p) => { %>
            <div class="live-player"><%= p.name %></div>
          <% }); %>
          <% gameGuests.b.forEach((g) => { %><div class="live-player live-player-guest">Guest: <%= g.first_name %></div><% }); %>
          <% if (liveGame.teamB.length + gameGuests.b.length === 0) { %><div class="live-player live-player-empty">&mdash;</div><% } %>
        </div>
      </div>

      <% const roomA = liveGame.teamA.length + gameGuests.a.length < size; const roomB = liveGame.teamB.length + gameGuests.b.length < size; %>
      <% const myTeam = liveGame.viewerTeam; %>
      <% const link = gn.joinLink && gn.joinLink.gameId === liveGame.id ? gn.joinLink : null; %>
      <% if (myTeam) { %>
        <div class="winners-note">You're on Team <%= myTeam === 'a' ? 'A' : 'B' %>.</div>
        <% const other = myTeam === 'a' ? 'b' : 'a'; %>
        <% if ((other === 'a' ? roomA : roomB)) { %>
          <form method="POST" action="/live_games/<%= liveGame.id %>/join" class="declare-row">
            <input type="hidden" name="side" value="<%= other %>">
            <button type="submit" class="small-btn">Wrong team? Switch to Team <%= other === 'a' ? 'A' : 'B' %></button>
          </form>
        <% } %>
      <% } else if (gn.viewerCheckedIn && link) { %>
        <div class="winners-note">You're joining Team <%= link.team === 'a' ? 'A' : 'B' %>.</div>
        <form method="POST" action="/live_games/<%= liveGame.id %>/join" class="declare-row">
          <input type="hidden" name="side" value="<%= link.team %>">
          <button type="submit" class="small-btn small-btn-accent">Join Team <%= link.team === 'a' ? 'A' : 'B' %></button>
        </form>
      <% } else if (gn.viewerCheckedIn) { %>
        <div class="winners-note">Tap the team your teammate is on.</div>
        <div class="declare-row">
          <% if (roomA) { %>
            <form method="POST" action="/live_games/<%= liveGame.id %>/join">
              <input type="hidden" name="side" value="a">
              <button type="submit" class="small-btn small-btn-accent">I'm on Team A</button>
            </form>
          <% } %>
          <% if (roomB) { %>
            <form method="POST" action="/live_games/<%= liveGame.id %>/join">
              <input type="hidden" name="side" value="b">
              <button type="submit" class="small-btn small-btn-accent">I'm on Team B</button>
            </form>
          <% } %>
        </div>
      <% } %>
      <% if (myTeam) { %>
        <div class="winners-note">Game done? Who won?</div>
        <div class="declare-row">
          <form method="POST" action="/live_games/<%= liveGame.id %>/declare">
            <input type="hidden" name="side" value="a">
            <button type="submit" class="small-btn">Team A</button>
          </form>
          <form method="POST" action="/live_games/<%= liveGame.id %>/declare">
            <input type="hidden" name="side" value="b">
            <button type="submit" class="small-btn">Team B</button>
          </form>
        </div>
      <% } %>
      <% if (liveGame.teamA.length + liveGame.teamB.length > 0) { %>
        <div class="qr-share">
          <button type="button" class="small-btn" data-share-url="<%= gn.liveShare.a %>">Send QR link for Team A</button>
          <button type="button" class="small-btn" data-share-url="<%= gn.liveShare.b %>">Send QR link for Team B</button>
        </div>
      <% } %>

      <% if (liveGame.viewerCaptainTeam && liveGame.status !== 'done') { %>
        <details class="captain-tools">
          <summary>Captain tools</summary>
          <% [...liveGame.teamA, ...liveGame.teamB].filter((p) => p.team === liveGame.viewerCaptainTeam).forEach((p) => { %>
            <form method="POST" action="/live_games/<%= liveGame.id %>/left" class="inline-form">
              <input type="hidden" name="playerId" value="<%= p.playerId %>">
              <span><%= p.name %></span>
              <button type="submit" class="tiny-btn">Mark left</button>
            </form>
          <% }); %>
          <% if (availablePlayers.length > 0) { %>
            <form method="POST" action="/live_games/<%= liveGame.id %>/sub" class="inline-form">
              <input type="hidden" name="team" value="<%= liveGame.viewerCaptainTeam %>">
              <select name="playerId">
                <% availablePlayers.forEach((p) => { %><option value="<%= p.id %>"><%= p.name %></option><% }); %>
              </select>
              <button type="submit" class="tiny-btn">Add sub</button>
            </form>
          <% } %>
        </details>
      <% } %>
    </div>
  <% } else { %>
    <div class="live-card live-card-idle">
      <div class="live-target"><%= court.nickname || ('Court ' + court.number) %> is open</div>
      <% if (courtHeater) { %><div class="heater-line">Last winners here: <span class="heater-tag<%= courtHeater.count >= 3 ? ' hot' : '' %>"><%= courtHeater.label %></span></div><% } %>
      <% if (gn.viewerCheckedIn) { %>
        <div class="winners-note">Pick a format and court on the next screen. Nothing starts until you tap Start game.</div>
      <% } else { %>
        <div class="winners-note">Check in at this park to start a game.</div>
      <% } %>
    </div>
  <% } %>

  <% const otherGames = parkGames.filter((g) => g.courtId !== court.id); %>
  <% otherGames.forEach((g) => { %>
    <a href="/parks/<%= park.id %>/courts/<%= g.courtId %>#live-<%= g.id %>" class="live-card live-run-other" id="live-<%= g.id %>">
      <div class="live-target"><%= g.format %> &middot; <%= g.courtLabel %> &middot; game on</div>
      <div class="live-run-meta"><%= g.onCount %> on &middot; <%= g.nextCount %> <%= g.nextCount === 1 ? 'team' : 'teams' %> next</div>
      <% if (g.heater) { %><div class="heater-line">Team <%= g.heater.team === 'a' ? 'A' : 'B' %>: <span class="heater-tag<%= g.heater.count >= 3 ? ' hot' : '' %>"><%= g.heater.label %></span></div><% } %>
      <div class="live-run-open">A separate game. Open <%= g.courtLabel %> &rsaquo;</div>
    </a>
  <% }); %>

  <details class="settings-details">
    <summary>Game settings</summary>
    <form method="POST" action="/parks/<%= park.id %>/settings" class="settings-form">
      <div class="form-group">
        <label for="gameTarget">Game target</label>
        <input type="number" id="gameTarget" name="gameTarget" min="1" value="<%= park.game_target %>">
      </div>
      <div class="form-group">
        <label for="betweenGamesMinutes">Time between games (minutes)</label>
        <input type="number" id="betweenGamesMinutes" name="betweenGamesMinutes" min="1" value="<%= Math.round(park.between_games_seconds / 60) %>">
      </div>
      <div class="form-group">
        <label for="checkInRadiusMeters">Check-in radius (meters)</label>
        <input type="number" id="checkInRadiusMeters" name="checkInRadiusMeters" min="1" value="<%= park.check_in_radius_meters %>">
      </div>
      <div class="form-group">
        <label for="leaveRadiusMeters">Leave radius (meters)</label>
        <input type="number" id="leaveRadiusMeters" name="leaveRadiusMeters" min="1" value="<%= park.leave_radius_meters %>">
      </div>
      <button type="submit" class="small-btn">Save</button>
    </form>
  </details>

  <div class="season-note leave-note">Leave past <%= park.leave_radius_meters %>m for 5+ minutes and you lose your spot.</div>
</div>
<%- include('partials/bottom-nav', { active: 'runs' }) %>

<script src="/geo.js"></script>
<script src="/park-photo.js"></script>
<script src="/court-sheet.js"></script>
<script>
  (function () {
    var parkId = <%= park.id %>;
    var checkedIn = <%= checkedIn ? 'true' : 'false' %>;

    var checkInBtn = document.getElementById('checkInBtn');
    if (checkInBtn) {
      checkInBtn.addEventListener('click', function () {
        var statusEl = document.getElementById('checkInStatus');
        checkInBtn.disabled = true;
        RoyaleGeo.checkIn({
          url: '/parks/' + parkId + '/check-in',
          onStatus: function (text) { statusEl.textContent = text; },
          onDone: function () { location.reload(); },
          onFail: function (message) {
            checkInBtn.disabled = false;
            statusEl.textContent = message;
          },
        });
      });
    } else if (checkedIn) {
      RoyaleGeo.startHeartbeat(parkId);
    }

    // Proactively swap the Check-in button for a distance message when
    // we're confident the player is outside the radius — rather than
    // waiting for them to tap Check in and hit the server-side error.
    // A rough fix isn't confident: the button stays, and tapping it goes
    // through the retry-for-a-better-signal path instead.
    var parkLat = <%- park.lat != null ? park.lat : 'null' %>;
    var parkLng = <%- park.lng != null ? park.lng : 'null' %>;
    var checkInRadiusMeters = <%= park.check_in_radius_meters %>;
    if (checkInBtn && parkLat != null) {
      RoyaleGeo.getPosition(function (pos) {
        if (RoyaleGeo.isRoughFix(pos)) return;
        var miles = RoyaleGeo.haversineMiles(pos.coords.latitude, pos.coords.longitude, parkLat, parkLng);
        if (miles * 1609.34 > checkInRadiusMeters) {
          document.getElementById('checkInNormal').style.display = 'none';
          var tooFar = document.getElementById('checkInTooFar');
          document.getElementById('tooFarMsg').textContent =
            "You're " + RoyaleGeo.distanceLabel(miles) + '. Check in opens when you get to the court.';
          tooFar.style.display = 'block';
        }
      });
    }

    var countdownEl = document.getElementById('countdown');
    if (countdownEl) {
      var endsAt = new Date('<%- countdownEndsAtIso %>').getTime();
      var tick = function () {
        var remaining = Math.max(0, Math.round((endsAt - Date.now()) / 1000));
        var m = Math.floor(remaining / 60);
        var s = remaining % 60;
        countdownEl.textContent = m + ':' + (s < 10 ? '0' : '') + s;
        if (remaining <= 0) {
          clearInterval(timer);
          setTimeout(function () { location.reload(); }, 1500);
        }
      };
      tick();
      var timer = setInterval(tick, 1000);
    }

    // Lightweight polling so other players' moves (someone else joins
    // the line, a game locks, a countdown resolves) show up without a
    // manual refresh.
    setInterval(function () { location.reload(); }, 15000);
  })();
</script>
</body>
</html>
