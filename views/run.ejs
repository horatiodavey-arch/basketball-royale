<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= run.courtName %> run — Basketball Royale</title>
<%- include('partials/fonts') %>
<%- include('partials/pwa-head') %>
<link rel="stylesheet" href="/style.css">
</head>
<body class="kotc">
<div class="page">
  <%- include('partials/royale-header') %>
  <div class="page-title heading"><%- include('partials/park-name', { name: run.parkName, city: run.parkCity }) %></div>
  <div class="page-sub"><%= run.courtName %><% if (run.parkLocation) { %> &middot; <%= run.parkLocation %><% } %></div>

  <% if (run.cancelled) { %>
    <div class="error-msg">This run was cancelled.<% if (run.viewerComing) { %> You had said you were coming. Check the Runs page for other runs nearby.<% } %></div>
  <% } %>
  <% if (error) { %>
    <div class="error-msg"><%= error %></div>
  <% } %>

  <div class="live-card">
    <div class="run-time heading"><%= formatRunTime(run.scheduledAt) %>
      <% if (!run.cancelled) { %>
        <% if (run.live) { %><span class="live-badge">Live</span><% } else { %><span class="scheduled-badge">Scheduled</span><% } %>
      <% } %>
    </div>
    <% if (run.note) { %><div class="run-note"><%= run.note %></div><% } %>
    <div class="run-organizer">Started by <%= maskName(run.organizerName) %></div>
  </div>

  <%# Green dot: checked in at the park (live). Yellow dot: said I'm coming, not here yet. %>
  <% const playerChip = (p, status) => { %>
    <div class="here-now-player person-chip">
      <div class="here-now-avatar"><%= p.initials %><span class="status-dot status-dot-<%= status %>" title="<%= status === 'here' ? 'Checked in' : 'Coming' %>"></span></div>
      <div class="here-now-name"><%= p.name.replace(/\s#\d{4}$/, '') %></div>
      <% const bolt = playStreakWeeks(p.id); %><% if (bolt >= 2) { %><div class="play-streak play-streak-chip">⚡ <%= bolt %></div><% } %>
      <%- include('partials/player-preview', { p: p }) %>
    </div>
  <% }; %>

  <div class="here-now-head">
    <span class="section" style="margin: 0;"><span class="status-dot-inline status-dot-here"></span>Here now &middot; <%= run.hereTotal %></span>
  </div>
  <% if (run.hereTotal === 0) { %>
    <div class="next-action-note">Nobody checked in at this park yet.</div>
  <% } else if (run.hereNow.length === 0) { %>
    <div class="next-action-note"><%= run.hereTotal %> here</div>
  <% } else { %>
    <div class="here-now-row">
      <% run.hereNow.forEach((p) => { %><%- playerChip(p, 'here') %><% }); %>
    </div>
  <% } %>

  <div class="here-now-head" style="margin-top: 14px;">
    <span class="section" style="margin: 0;"><span class="status-dot-inline status-dot-coming"></span>Coming &middot; <%= run.rsvpCount %></span>
  </div>
  <% if (run.cancelled || run.ended) { %>
    <div class="next-action-note"><%= run.cancelled ? 'This run was cancelled.' : 'This run has ended.' %></div>
  <% } else if (run.rsvpCount > 0 && run.rsvps.length === 0) { %>
    <div class="next-action-note"><%= run.rsvpCount %> coming</div>
  <% } else if (run.rsvps.length === 0) { %>
    <div class="next-action-note">Nobody's said they're coming yet &mdash; be the first.</div>
  <% } else { %>
    <div class="here-now-row">
      <% run.rsvps.forEach((p) => { %><%- playerChip(p, 'coming') %><% }); %>
    </div>
  <% } %>

  <div class="sheet-actions" style="margin-top: 18px;">
    <% if (run.cancelled) { %>
    <% } else if (!profile) { %>
      <a href="/signup?returnTo=<%= encodeURIComponent('/runs/' + run.id) %>" class="submit-btn" style="text-align: center; text-decoration: none; display: block;">Sign up to say you're coming</a>
    <% } else { %>
      <%# Away from the court: I'm coming. The page switches to the at-court group when the phone is at the court. %>
      <div class="run-away">
        <% if (run.viewerComing) { %>
          <form method="POST" action="/runs/<%= run.id %>/not-coming" style="flex: 1;" onsubmit="return confirm('Take yourself off this run?');">
            <button type="submit" class="check-in-btn check-in-btn-in">You're coming &middot; tap to take yourself off</button>
          </form>
        <% } else { %>
          <form method="POST" action="/runs/<%= run.id %>/coming" style="flex: 1;">
            <button type="submit" class="submit-btn">I'm coming</button>
          </form>
        <% } %>
        <div class="run-away-note" id="runAwayNote"></div>
      </div>
      <%# At the court: Check in, and I got next. Hidden until the location says the phone is at the court. %>
      <div class="run-at-court" style="display: none;">
        <% if (viewerCheckedIn) { %>
          <button type="button" class="submit-btn" disabled>Checked in</button>
        <% } else { %>
          <button type="button" class="submit-btn" id="runCheckInBtn" data-park-id="<%= run.parkId %>">Check in</button>
        <% } %>
        <form method="POST" action="/courts/<%= run.courtId %>/next" style="margin-top: 10px;">
          <button type="submit" class="small-btn small-btn-accent" style="width: 100%;">I got next</button>
        </form>
      </div>
    <% } %>
  </div>

  <% if (isOrganizer && !run.cancelled) { %>
    <% if (run.canChange) { %>
      <details class="run-manage" style="margin-top: 14px;">
        <summary class="small-btn" style="display: inline-block;">Change time</summary>
        <form method="POST" action="/runs/<%= run.id %>/edit" class="settings-form" style="margin-top: 10px;">
          <%- include('partials/run-time-fields', { prefix: 'edit', date: run.scheduledDate, time: run.scheduledTime, todayDate: todayDate, nowTime: nowTime }) %>
          <button type="submit" class="submit-btn">Save time</button>
        </form>
      </details>
      <form method="POST" action="/runs/<%= run.id %>/cancel" onsubmit="return confirm('Cancel this run? Everyone who said they are coming will see that it was cancelled.');" style="margin-top: 12px;">
        <button type="submit" class="small-btn">Cancel run</button>
      </form>
    <% } else { %>
      <div class="next-action-note">A game at this court has started, so this run can't be changed.</div>
    <% } %>
  <% } %>

  <button type="button" id="inviteBtn" class="small-btn" style="margin-top: 10px;">Invite friends</button>

  <div class="season-note" style="text-align: center; margin-top: 18px;">
    <a href="/parks/<%= run.parkId %>" class="player-link" style="color: var(--accent); font-weight: 600;">View court &rsaquo;</a>
  </div>
</div>
<%- include('partials/bottom-nav', { active: 'runs' }) %>

<script src="/geo.js"></script>
<script src="/track.js"></script>
<script src="/player-preview.js"></script>
<script>
  // At the court (within the park's check-in radius): Check in and I got next.
  // Away: I'm coming. Uses the location fix; without one, the away group stays.
  (function () {
    var parkLat = <%- JSON.stringify(run.parkLat) %>;
    var parkLng = <%- JSON.stringify(run.parkLng) %>;
    var radiusM = <%= run.checkInRadiusMeters || 250 %>;
    var away = document.querySelector('.run-away');
    var atCourt = document.querySelector('.run-at-court');
    var note = document.getElementById('runAwayNote');
    var checkBtn = document.getElementById('runCheckInBtn');
    if (checkBtn) {
      checkBtn.addEventListener('click', function () {
        var original = checkBtn.textContent;
        checkBtn.disabled = true;
        RoyaleGeo.checkIn({
          url: '/parks/' + checkBtn.getAttribute('data-park-id') + '/check-in',
          onStatus: function (text) { checkBtn.textContent = text; },
          onDone: function () { location.reload(); },
          onFail: function (message) { checkBtn.disabled = false; checkBtn.textContent = original; alert(message); },
        });
      });
    }
    if (parkLat === null || parkLng === null || !away || !atCourt) return;
    RoyaleGeo.getPosition(function (pos) {
      var miles = RoyaleGeo.haversineMiles(pos.coords.latitude, pos.coords.longitude, parkLat, parkLng);
      var meters = miles * 1609.34;
      if (meters <= radiusM) {
        atCourt.style.display = 'block';
        away.style.display = 'none';
      } else if (note) {
        note.textContent = "You're " + RoyaleGeo.distanceLabel(miles) + ' away. Get to the court to check in.';
      }
    }, function () {});
  })();
  (function () {
    var courtName = <%- JSON.stringify(run.courtName).replace(/</g, '\\u003c') %>;
    var timeLabel = <%- JSON.stringify(formatRunTime(run.scheduledAt)).replace(/</g, '\\u003c') %>;
    document.getElementById('inviteBtn').addEventListener('click', function () {
      var url = window.location.origin + '/runs/<%= run.id %>'<% if (profile && profile.tag) { %> + '?ref=<%= profile.tag %>'<% } %>;
      var text = 'Pull up to ' + courtName + ' ' + timeLabel + ". Let's see who takes the crown.";
      <% if (profile) { %>RoyaleTrack.report('invite_friends');<% } %>
      if (navigator.share) {
        navigator.share({ title: 'Basketball Royale', text: text, url: url }).catch(function () {});
      } else if (navigator.clipboard) {
        navigator.clipboard.writeText(text + ' ' + url).then(function () {
          alert('Invite link copied to clipboard');
        });
      } else {
        alert(text + ' ' + url);
      }
    });
  })();
</script>
</body>
</html>
