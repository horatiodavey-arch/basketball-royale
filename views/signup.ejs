<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Basketball Royale — Sign up</title>
<link rel="stylesheet" href="/style.css">
</head>
<body>
<div class="phone">
  <div class="brand">&#127936; Basketball Royale</div>
  <div class="brand-sub">Enter your name and phone to get on the court.</div>

  <% if (error) { %>
    <div class="error-msg"><%= error %></div>
  <% } %>

  <form method="POST" action="/signup">
    <div class="field">
      <label for="name">Name</label>
      <input type="text" id="name" name="name" value="<%= name %>" placeholder="Horatio D." autofocus required>
    </div>
    <div class="field">
      <label for="phone">Phone number</label>
      <input type="tel" id="phone" name="phone" value="<%= phone %>" placeholder="555-000-0000" required>
    </div>
    <button type="submit" class="submit">Join the run</button>
  </form>

  <div class="fine" style="margin-top: 14px;">Already signed up? Enter the same phone number to jump back in.</div>
</div>
</body>
</html>
