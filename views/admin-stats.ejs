<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Click tracking — Basketball Royale</title>
<%- include('partials/fonts') %>
<%- include('partials/pwa-head') %>
<link rel="stylesheet" href="/style.css">
</head>
<body class="kotc">
<div class="page">
  <%- include('partials/royale-header') %>
  <div class="page-title heading">Organizer</div>
  <div class="page-sub">Taps on the app's key actions, organizer-only.</div>
  <%- include('partials/admin-tabs', { tab: 'stats' }) %>

  <div class="section" style="margin-top: 0;">Funnel</div>
  <div class="stats-card">
    <% funnel.forEach((step) => { %>
      <div class="funnel-step">
        <div class="funnel-head">
          <span class="funnel-label"><%= step.label %></span>
          <span>
            <span class="funnel-count heading"><%= step.count %></span>
            <% if (step.percentOfPrevious !== null) { %><span class="funnel-pct"><%= step.percentOfPrevious %>% of previous step</span><% } %>
          </span>
        </div>
        <div class="bar"><div class="fill" style="width: <%= step.percentOfSignups %>%;"></div></div>
      </div>
    <% }); %>
  </div>
  <div class="season-note">Each step counts only players who also made the step before it.</div>

  <div class="section">Taps</div>
  <% events.forEach((e) => { %>
    <div class="stats-card">
      <div class="stats-label"><%= e.label %></div>
      <div class="stats-tiles">
        <div class="stats-tile">
          <div class="stats-tile-value heading"><%= e.totalTaps %></div>
          <div class="stats-tile-label">Total taps</div>
        </div>
        <div class="stats-tile">
          <div class="stats-tile-value heading"><%= e.uniquePlayers %></div>
          <div class="stats-tile-label">Unique players</div>
        </div>
        <div class="stats-tile">
          <div class="stats-tile-value heading"><%= e.tapsPerDay %></div>
          <div class="stats-tile-label">Taps / day</div>
        </div>
      </div>
    </div>
  <% }); %>
</div>
<%- include('partials/bottom-nav', { active: active }) %>
</body>
</html>
