<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Admin dashboard — Basketball Royale</title>
<%- include('partials/fonts') %>
<%- include('partials/pwa-head') %>
<link rel="stylesheet" href="/style.css">
</head>
<body class="kotc">
<div class="page admin-dashboard">
  <div class="page-title heading">Admin</div>
  <div class="page-sub"><%= dashboard.rangeLabel %> &middot; updated <%= dashboard.generatedAt %> UTC &middot; read-only</div>

  <div class="section admin-section">Tracking check</div>
  <div class="admin-big">
    <div class="admin-stat">
      <div class="admin-stat-value heading"><%= tracking.totalPlayers %></div>
      <div class="admin-stat-label">Total players</div>
    </div>
    <% tracking.milestones.forEach((m) => { %>
      <div class="admin-stat">
        <div class="admin-stat-value heading"><%= m.players %></div>
        <div class="admin-stat-label"><%= m.label %></div>
      </div>
    <% }); %>
  </div>
  <div class="season-note">Milestones count each player once, the first time it happened. Ever, not this range.</div>

  <div class="admin-table-head">
    <span class="admin-table-title">Every event, all time</span>
  </div>
  <div class="admin-table-wrap">
    <table class="admin-table">
      <thead><tr><th>Event</th><th>Taps</th><th>Unique players</th><th>Per day</th></tr></thead>
      <tbody>
        <% tracking.events.forEach((e) => { %>
          <tr><td><%= e.label %></td><td><%= e.totalTaps %></td><td><%= e.uniquePlayers %></td><td><%= e.tapsPerDay %></td></tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <div class="admin-table-head">
    <span class="admin-table-title">Where players came from</span>
  </div>
  <div class="admin-table-wrap">
    <table class="admin-table">
      <thead><tr><th>Source</th><th>Players</th></tr></thead>
      <tbody>
        <% tracking.bySource.forEach((s) => { %>
          <tr><td><%= s.source %></td><td><%= s.players %></td></tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <a class="small-btn" href="/admin/backup" style="display: inline-block; margin: 14px 0 6px;">Download backup</a>
  <div class="season-note">A full copy of the database, dated today. It contains player phone numbers, so keep it private.</div>

  <div class="range-tabs">
    <% [['7', 'Last 7 days'], ['30', 'Last 30 days'], ['all', 'All time']].forEach(([key, label]) => { %>
      <a class="range-tab <%= dashboard.range === key ? 'active' : '' %>" href="/admin?range=<%= key %>"><%= label %></a>
    <% }); %>
  </div>

  <% dashboard.sections.forEach((section) => { %>
    <div class="section admin-section"><%= section.title %></div>
    <div class="admin-big">
      <% section.big.forEach((stat) => { %>
        <div class="admin-stat">
          <div class="admin-stat-value heading"><%= stat.value %></div>
          <div class="admin-stat-label"><%= stat.label %></div>
        </div>
      <% }); %>
    </div>
    <% if (section.note) { %><div class="season-note"><%= section.note %></div><% } %>
    <% if (section.eventPicker) { %>
      <form method="GET" action="/admin" class="event-picker">
        <input type="hidden" name="range" value="<%= dashboard.range %>">
        <label for="eventPick">Event</label>
        <select id="eventPick" name="event" onchange="this.form.submit()">
          <% section.eventPicker.options.forEach((o) => { %>
            <option value="<%= o.name %>" <%= o.name === section.eventPicker.selected ? 'selected' : '' %>><%= o.label %></option>
          <% }); %>
        </select>
        <noscript><button type="submit" class="small-btn">Show</button></noscript>
      </form>
    <% } %>
    <% (section.charts || []).forEach((chart) => { const max = Math.max(1, ...chart.values); const slot = 24; %>
      <div class="admin-table-head"><span class="admin-table-title"><%= chart.title %></span></div>
      <% if (chart.values.length === 0) { %>
        <div class="next-action-note">Nothing in this range yet.</div>
      <% } else { %>
        <svg class="admin-chart" viewBox="0 0 <%= chart.values.length * slot %> 100" preserveAspectRatio="none" role="img" aria-label="<%= chart.title %>">
          <% chart.values.forEach((v, i) => { const h = Math.round((v / max) * 92); %>
            <rect x="<%= i * slot + 3 %>" y="<%= 100 - h %>" width="<%= slot - 6 %>" height="<%= h %>" rx="3"><title><%= chart.labels[i] %>: <%= v %></title></rect>
          <% }); %>
        </svg>
        <div class="admin-chart-axis"><span><%= chart.labels[0] %></span><span><%= chart.labels[chart.labels.length - 1] %></span></div>
      <% } %>
    <% }); %>
    <% (section.tables || []).forEach((key) => { const table = dashboard.tables[key]; %>
      <div class="admin-table-head">
        <span class="admin-table-title"><%= table.title %></span>
        <a class="tiny-btn" href="/admin/export/<%= key %>?range=<%= dashboard.range %>&event=<%= encodeURIComponent(dashboard.event || '') %>">Export CSV</a>
      </div>
      <% if (table.rows.length === 0) { %>
        <div class="next-action-note">Nothing in this range yet.</div>
      <% } else { %>
        <div class="admin-table-wrap">
          <table class="admin-table">
            <thead><tr><% table.headers.forEach((h) => { %><th><%= h %></th><% }); %></tr></thead>
            <tbody>
              <% table.rows.forEach((row) => { %>
                <tr><% row.forEach((cell) => { %><td><%= cell %></td><% }); %></tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    <% }); %>
  <% }); %>

  <form method="POST" action="/admin/logout" style="margin-top: 24px;">
    <button type="submit" class="small-btn">Log out</button>
  </form>
</div>
</body>
</html>
