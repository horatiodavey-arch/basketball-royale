<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Courts — Basketball Royale</title>
<%- include('partials/fonts') %>
<link rel="stylesheet" href="/vendor/leaflet/leaflet.css">
<link rel="stylesheet" href="/style.css">
</head>
<body class="kotc">
<div class="page">
  <div class="page-title heading">Courts</div>
  <div class="page-sub">Suggestions to review, and every park's own settings &mdash; organizer-only.</div>

  <div class="section">Suggestions</div>
  <% if (suggestions.length === 0) { %>
    <div class="empty-board">No suggestions yet.</div>
  <% } %>

  <% suggestions.forEach((s) => { %>
    <div class="stats-card">
      <div class="stats-label"><%= s.name %></div>
      <div class="suggestion-meta">
        Suggested by <%= s.suggested_by_name %> &middot; <%= s.lat.toFixed(5) %>, <%= s.lng.toFixed(5) %>
      </div>
      <% if (s.photo_url) { %>
        <img src="<%= s.photo_url %>" alt="Photo of <%= s.name %>" class="suggestion-photo">
      <% } %>
      <% if (s.status === 'pending') { %>
        <div class="declare-row" style="margin-top: 10px;">
          <form method="POST" action="/admin/courts/<%= s.id %>/approve">
            <button type="submit" class="small-btn small-btn-accent">Approve</button>
          </form>
          <form method="POST" action="/admin/courts/<%= s.id %>/reject">
            <button type="submit" class="small-btn">Reject</button>
          </form>
        </div>
      <% } else { %>
        <div class="suggestion-status suggestion-status-<%= s.status %>">
          <%= s.status === 'approved' ? 'Approved' : 'Rejected' %>
        </div>
      <% } %>
    </div>
  <% }); %>

  <div class="section">Parks</div>
  <% parks.forEach((p) => { %>
    <details class="admin-park-card">
      <summary class="admin-park-summary">
        <span class="admin-park-name"><%= p.name %></span>
        <span class="source-badge source-badge-<%= p.source %>">
          <% if (p.source === 'auto') { %>Auto-created
          <% } else if (p.source === 'suggested') { %>Suggested by <%= p.added_by_name || 'a player' %>
          <% } else { %>Preset
          <% } %>
        </span>
        <% if (p.is_suggested) { %><span class="source-badge source-badge-featured">Featured</span><% } %>
      </summary>

      <form method="POST" action="/admin/parks/<%= p.id %>/update" class="settings-form admin-park-form">
        <div class="form-group">
          <label for="name-<%= p.id %>">Name</label>
          <input type="text" id="name-<%= p.id %>" name="name" value="<%= p.name %>" required>
        </div>
        <div class="form-group">
          <label for="location-<%= p.id %>">Address</label>
          <input type="text" id="location-<%= p.id %>" name="location" value="<%= p.location || '' %>">
        </div>
        <div class="form-group">
          <label>Pin location &mdash; drag the marker onto the actual courts</label>
          <div id="admin-map-<%= p.id %>" class="admin-pin-map" data-park-id="<%= p.id %>" data-lat="<%= p.lat %>" data-lng="<%= p.lng %>"></div>
          <input type="hidden" id="lat-<%= p.id %>" name="lat" value="<%= p.lat %>">
          <input type="hidden" id="lng-<%= p.id %>" name="lng" value="<%= p.lng %>">
        </div>
        <div class="form-group">
          <label for="checkin-<%= p.id %>">Check-in radius (meters)</label>
          <input type="number" id="checkin-<%= p.id %>" name="checkInRadiusMeters" min="1" value="<%= p.check_in_radius_meters %>">
        </div>
        <div class="form-group">
          <label for="leave-<%= p.id %>">Leave radius (meters)</label>
          <input type="number" id="leave-<%= p.id %>" name="leaveRadiusMeters" min="1" value="<%= p.leave_radius_meters %>">
        </div>
        <label class="player-check">
          <input type="checkbox" name="isSuggested" <%= p.is_suggested ? 'checked' : '' %>>
          Suggested &mdash; featured at the top of the Runs tab
        </label>
        <button type="submit" class="small-btn small-btn-accent" style="margin-top: 10px;">Save</button>
      </form>
    </details>
  <% }); %>
</div>
<%- include('partials/bottom-nav', { active: active }) %>

<script src="/vendor/leaflet/leaflet.js"></script>
<script>
  (function () {
    var maps = {};

    document.querySelectorAll('.admin-park-card').forEach(function (details) {
      details.addEventListener('toggle', function () {
        if (!details.open) return;
        var mapDiv = details.querySelector('.admin-pin-map');
        var parkId = mapDiv.getAttribute('data-park-id');

        if (maps[parkId]) {
          setTimeout(function () { maps[parkId].invalidateSize(); }, 50);
          return;
        }

        var lat = parseFloat(mapDiv.getAttribute('data-lat'));
        var lng = parseFloat(mapDiv.getAttribute('data-lng'));
        if (isNaN(lat) || isNaN(lng)) return;

        var map = L.map(mapDiv, { zoomControl: true }).setView([lat, lng], 17);
        L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
          maxZoom: 19,
          subdomains: 'abcd',
          attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
        }).addTo(map);

        var marker = L.marker([lat, lng], { draggable: true }).addTo(map);
        marker.on('dragend', function () {
          var pos = marker.getLatLng();
          document.getElementById('lat-' + parkId).value = pos.lat;
          document.getElementById('lng-' + parkId).value = pos.lng;
        });

        maps[parkId] = map;
        setTimeout(function () { map.invalidateSize(); }, 50);
      });
    });
  })();
</script>
</body>
</html>
