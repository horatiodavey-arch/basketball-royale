<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>How it works — Basketball Royale</title>
<%- include('partials/fonts') %>
<link rel="stylesheet" href="/style.css">
</head>
<body class="kotc">
<div class="page">
  <%- include('partials/royale-header') %>
  <div class="page-title heading">How it works</div>
  <div class="page-sub">Points, crown levels, and what each one unlocks.</div>

  <div class="crowns-info" style="margin-top: 0;">
    <h4 class="heading">Point breakdown</h4>
    <div class="rules-line" style="border-top: none; padding-top: 0; margin-top: 0;">
      Win = 3 pts &middot; Game = 1 pt &middot; Court hour = 1 pt. Crowns reset every 30 days.
    </div>
    <div class="trophy-rule">Your crown resets, but it's saved as a trophy. Trophies move you up the ladder.</div>
  </div>

  <div class="crowns-info">
    <h4 class="heading">Crown levels</h4>
    <% crownLevels.slice().reverse().forEach((level) => { %>
      <div class="crown-row">
        <%- include('partials/crown-icon', { size: 18, fill: level.fill, stroke: level.stroke }) %>
        <span><strong><%= level.name %></strong> &middot; <%= level.min %>+ pts</span>
      </div>
    <% }); %>
  </div>

  <div class="section">The ladder</div>
  <%- include('partials/tier-ladder', { ladder: ladder }) %>

  <div class="section">Crown perks</div>
  <% perks.forEach((perk) => { %>
    <div class="perk-row <%= perk.earned ? 'earned' : 'locked' %>">
      <div class="perk-icon">
        <% if (perk.earned) { %>
          <%- include('partials/crown-icon', { size: 26, fill: perk.fill, stroke: perk.stroke }) %>
        <% } else { %>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--muted)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
        <% } %>
      </div>
      <div class="perk-main">
        <div class="perk-name"><%= perk.name %></div>
        <div class="perk-desc"><%= perk.description %></div>
      </div>
      <div class="perk-status">
        <% if (perk.earned) { %>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--green-text)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        <% } else { %>
          <span class="perk-hint"><%= perk.lockedHint %></span>
        <% } %>
      </div>
    </div>
  <% }); %>
</div>
<%- include('partials/bottom-nav', { active: 'map' }) %>
</body>
</html>
