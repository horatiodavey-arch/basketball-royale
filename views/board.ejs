<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Leaderboard — Basketball Royale</title>
<%- include('partials/fonts') %>
<link rel="stylesheet" href="/style.css">
</head>
<body class="kotc">
<div class="page">
  <%- include('partials/royale-header', { trophyNote: true }) %>
  <div class="page-title heading">Leaderboard</div>
  <div class="page-sub">King of the Court &mdash; season standings.</div>

  <% if (parks.length === 0) { %>
    <div class="empty-board">No parks yet. Record a game to get things started.</div>
  <% } else { %>
    <div class="board-controls">
      <select class="park-select" onchange="location.href = '/board?scope=<%= scope %>&park=' + this.value + '<%= format ? '&format=' + format : '' %>';">
        <% parks.forEach((park) => { %>
          <option value="<%= park.id %>" <%= park.id === selectedPark.id ? 'selected' : '' %>><%= park.name %><% if (park.city) { %> &middot; <%= park.city %><% } %></option>
        <% }); %>
      </select>
      <div class="tabs">
        <a class="tab <%= scope === 'court' ? 'active' : '' %>" href="/board?scope=court&park=<%= selectedPark.id %><%= format ? '&format=' + format : '' %>">Court</a>
        <a class="tab <%= scope === 'city' ? 'active' : '' %>" href="/board?scope=city&park=<%= selectedPark.id %><%= format ? '&format=' + format : '' %>">City</a>
      </div>
      <div class="tabs format-tabs">
        <a class="tab <%= !format ? 'active' : '' %>" href="/board?scope=<%= scope %>&park=<%= selectedPark.id %>">All</a>
        <% formats.forEach((f) => { %>
          <a class="tab <%= format === f ? 'active' : '' %>" href="/board?scope=<%= scope %>&park=<%= selectedPark.id %>&format=<%= f %>"><%= f %></a>
        <% }); %>
      </div>
    </div>

    <div class="season-note">Resets in <%= season.daysLeft %> day<%= season.daysLeft === 1 ? '' : 's' %>.</div>

    <div class="live-part" data-live-key="body" data-live-url="<%= liveUrl %>" data-live-v="<%= liveVersion %>">
      <%- include('partials/board-live', { rows: rows, profile: profile }) %>
    </div>
    <% if (rows.length > 0 && !onBoard) { %>
      <div class="empty-state">You're not on the board yet. One game gets you on it.</div>
    <% } %>
  <% } %>

  <div class="crowns-info">
    <h4 class="heading">How crowns work</h4>
    <% crownLevels.slice().reverse().forEach((level) => { %>
      <div class="crown-row">
        <%- include('partials/crown-icon', { size: 18, fill: level.fill, stroke: level.stroke }) %>
        <span><strong><%= level.name %></strong> &middot; <%= level.min %>+ pts</span>
      </div>
    <% }); %>
    <div class="rules-line">Win = 3 pts &middot; Game = 1 pt &middot; Court hour = 1 pt. Crowns reset every 30 days.</div>
  </div>
</div>
<%- include('partials/bottom-nav', { active: 'board' }) %>
<script src="/live.js"></script>
</body>
</html>
