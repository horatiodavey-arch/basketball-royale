<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Basketball Royale</title>
<%- include('partials/fonts') %>
<link rel="stylesheet" href="/vendor/leaflet/leaflet.css">
<link rel="stylesheet" href="/vendor/maplibre-gl/maplibre-gl.css">
<link rel="stylesheet" href="/style.css">
</head>
<body class="kotc">
<div class="page map-page">

  <%- include('partials/royale-header', { trophyNote: true }) %>

  <% if (showIntro) { %><%- include('partials/how-it-works-card', { returnTo: '/' }) %><% } %>
  <% if (!anyLive) { %><div class="empty-state">No runs live right now. Follow a park to know when one starts.</div><% } %>

  <div class="hero-standing">
    <div class="hero-crown-level heading"><%= crown ? crown.name : 'No crown yet' %></div>
    <div class="hero-points"><%= totalPoints %> pts this season</div>
    <div class="hero-subline">
      <% if (nextCrown) { %>
        <%= nextCrown.pointsNeeded %> pts to <%= nextCrown.name %>
      <% } else { %>
        You've got the top crown &mdash; Best Record in the League.
      <% } %>
    </div>
    <a href="/how-it-works" class="how-it-works-link">How it works &rsaquo;</a>
  </div>

  <% if (pins.length === 0) { %>
    <div class="empty-board">No parks yet.</div>
  <% } else { %>
    <div id="locationBanner" class="location-banner" style="display: none;"></div>
    <div class="map-wrap">
      <div id="map" class="leaflet-map"></div>
      <button type="button" id="suggestCourtBtn" class="suggest-court-btn">+ Suggest a court</button>
      <div id="suggestCourtPanel" class="suggest-court-panel" style="display: none;">
        <p>Tap the map to drop a pin, then name the court.</p>
        <input type="text" id="suggestCourtName" placeholder="Court name" maxlength="80">
        <label class="suggest-court-photo-label" for="suggestCourtPhoto">+ Add a photo (optional)</label>
        <input type="file" id="suggestCourtPhoto" accept="image/*" style="display: none;">
        <div id="suggestCourtPhotoPreviewWrap" style="display: none;">
          <img id="suggestCourtPhotoPreview" class="suggest-court-photo-preview" alt="Selected photo">
          <button type="button" id="suggestCourtPhotoRemove" class="tiny-btn">Remove photo</button>
        </div>
        <div id="suggestCourtPhotoError" class="error-msg" style="display: none; margin: 8px 0 0;"></div>
        <div class="declare-row">
          <button type="button" id="suggestCourtCancel" class="small-btn">Cancel</button>
          <button type="button" id="suggestCourtSubmit" class="small-btn small-btn-accent" disabled>Submit</button>
        </div>
      </div>
      <div id="openCourtPanel" class="suggest-court-panel" style="display: none;">
        <p id="openCourtName"></p>
        <div class="declare-row">
          <button type="button" id="openCourtCancel" class="small-btn">Close</button>
          <button type="button" id="openCourtCheckIn" class="small-btn small-btn-accent">Check in</button>
        </div>
        <div class="declare-row" style="margin-top: 8px;">
          <a id="openCourtStartRun" href="#" class="small-btn link-btn">Start run</a>
          <button type="button" id="openCourtFollow" class="small-btn">Follow</button>
        </div>
      </div>
    </div>
    <div id="toast" class="location-banner" style="display: none;"></div>

    <div class="bottom-sheet">
      <div class="sheet-handle"></div>
      <div class="park-title-row">
        <div class="sheet-park-name heading"><%- include('partials/park-name', { name: sheet.park.name, city: sheet.park.city }) %></div>
        <%- include('partials/park-photo-button', { parkId: sheet.park.id, canAdd: canAddPhoto, isOrganizer: !!profile.is_organizer, statusId: 'sheetPhotoStatus' }) %>
      </div>
      <div class="sheet-meta">
        <span class="sheet-dot <%= sheet.activeCount > 0 ? 'sheet-dot-active' : 'sheet-dot-idle' %>"></span>
        <%= sheet.activeCount %> active now &middot; <%= sheet.liveCount %> game<%= sheet.liveCount === 1 ? '' : 's' %> live
      </div>
      <div id="sheetDistance" class="sheet-distance"></div>
      <div id="sheetPhotoStatus" class="park-photo-status"></div>

      <% if (sheet.king) { %>
        <div class="king-card sheet-king-card">
          <div class="king-label">KING OF THE COURT</div>
          <div class="king-crown">
            <%- include('partials/crown-icon', { size: 26, fill: sheet.king.crown ? sheet.king.crown.fill : 'none', stroke: sheet.king.crown ? sheet.king.crown.stroke : 'var(--muted)' }) %>
          </div>
          <div class="king-name heading"><%= sheet.king.name %></div>
          <div class="king-level"><%= sheet.king.crown ? sheet.king.crown.name : 'No crown yet' %></div>
          <div class="king-points heading"><%= sheet.king.points %> <span>pts</span></div>
        </div>
      <% } %>

      <div class="here-now-head">
        <span class="section" style="margin: 0;">Here now</span>
        <% if (sheet.hereNow.length > 5) { %>
          <a href="/parks/<%= sheet.park.id %>" class="see-all-link">See all <%= sheet.hereNow.length %></a>
        <% } %>
      </div>
      <% if (sheet.hereNow.length === 0) { %>
        <div class="next-action-note">Nobody checked in yet.</div>
      <% } else { %>
        <div class="here-now-row">
          <% sheet.hereNow.slice(0, 5).forEach((p) => { %>
            <div class="here-now-player">
              <div class="here-now-avatar <%= p.id === profile.player_id ? 'here-now-avatar-you' : '' %>">
                <%= p.initials %>
                <span class="here-now-crown"><%- include('partials/crown-icon', { size: 13, fill: p.crown ? p.crown.fill : 'none', stroke: p.crown ? p.crown.stroke : 'var(--muted)' }) %></span>
              </div>
              <div class="here-now-name"><%= p.id === profile.player_id ? 'You' : p.name %></div>
              <div class="here-now-pts"><%= p.points %> pts</div>
            </div>
          <% }); %>
        </div>
      <% } %>

      <% if (sheet.upcomingRuns.length > 0) { %>
        <div class="section">Upcoming runs</div>
        <% sheet.upcomingRuns.forEach((run) => { %>
          <a href="/runs/<%= run.id %>" class="park-link run-card">
            <div class="park-link-name"><%= formatRunTime(run.scheduledAt) %></div>
            <div class="park-link-location"><%= run.rsvpCount %> coming<% if (run.note) { %> &middot; <%= run.note %><% } %></div>
          </a>
        <% }); %>
      <% } %>

      <div class="sheet-status"><%= sheet.viewerStatus %></div>

      <% if (sheet.checkedIn) { %>
        <div class="sheet-actions">
          <button type="button" class="check-in-btn" disabled>Checked in</button>
          <form method="POST" action="/courts/<%= sheet.firstCourtId %>/next">
            <button type="submit" class="submit-btn" <%= sheet.firstCourtId ? '' : 'disabled' %>>I got next</button>
          </form>
        </div>
      <% } else { %>
        <div id="sheetCheckInNormal" class="sheet-actions">
          <button type="button" id="homeCheckInBtn" class="check-in-btn">Check in</button>
          <form method="POST" action="/courts/<%= sheet.firstCourtId %>/next">
            <button type="submit" class="submit-btn" <%= sheet.firstCourtId ? '' : 'disabled' %>>I got next</button>
          </form>
        </div>
        <div id="sheetTooFar" class="too-far-box" style="display: none;">
          <div class="too-far-msg" id="sheetTooFarMsg"></div>
          <% if (sheet.upcomingRuns.length > 0) { %>
            <form method="POST" action="/runs/<%= sheet.upcomingRuns[0].id %>/coming" style="margin-top: 8px;">
              <button type="submit" class="small-btn">I'm coming</button>
            </form>
          <% } %>
        </div>
      <% } %>
      <div id="homeCheckInStatus" class="checkin-status"></div>

      <div class="court-actions-row" style="margin-top: 12px;">
        <a href="/runs/new?courtId=<%= sheet.firstCourtId %>" class="small-btn link-btn">Start run</a>
        <form method="POST" action="/courts/<%= sheet.firstCourtId %>/follow">
          <button type="submit" class="small-btn <%= sheet.isFollowing ? 'small-btn-accent' : '' %>"><%= sheet.isFollowing ? 'Following ✓' : 'Follow' %></button>
        </form>
        <button type="button" id="inviteBtn" class="small-btn">Invite</button>
      </div>
    </div>
  <% } %>
</div>
<%- include('partials/bottom-nav', { active: 'map' }) %>

<script src="/geo.js"></script>
<script src="/track.js"></script>
<% if (pins.length > 0) { %>
<script src="/vendor/leaflet/leaflet.js"></script>
<script src="/vendor/maplibre-gl/maplibre-gl.js"></script>
<script src="/vendor/maplibre-gl-leaflet/leaflet-maplibre-gl.js"></script>
<script src="/map-tiles.js"></script>
<script src="/park-photo.js"></script>
<script>
  (function () {
    var pins = <%- JSON.stringify(pins).replace(/</g, '\\u003c') %>;
    var selectedParkData = <%- JSON.stringify({
      id: selectedPark.id,
      lat: selectedPark.lat,
      lng: selectedPark.lng,
      checkInRadiusMeters: selectedPark.check_in_radius_meters,
    }).replace(/</g, '\\u003c') %>;
    function escapeHtml(s) {
      return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function crownSvg(fill, stroke, size) {
      return '<svg width="' + size + '" height="' + size + '" viewBox="0 0 24 24">' +
        '<path d="M3 8l4.5 4L12 5l4.5 7L21 8l-2 10H5L3 8z" fill="' + fill + '" stroke="' + stroke + '" stroke-width="1.5" stroke-linejoin="round"/>' +
        '<path d="M5 20.5h14" stroke="' + stroke + '" stroke-width="1.5" stroke-linecap="round" fill="none"/>' +
        '</svg>';
    }

    function formatRunTimeShort(scheduledAt) {
      var d = new Date(scheduledAt.replace(' ', 'T'));
      var weekday = d.toLocaleDateString('en-US', { weekday: 'short' });
      var time = d.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' });
      return weekday + ' ' + time;
    }

    // The park with the most people active right now gets the gold treatment.
    function topActivePinId() {
      var top = null;
      pins.forEach(function (p) {
        if (p.activeCount > 0 && (!top || p.activeCount > top.activeCount)) top = p;
      });
      return top ? top.id : null;
    }

    function pinHtml(pin, isSelected, miles) {
      var isTop = pin.id === topActivePinId();
      var fill = (pin.king && pin.king.crown) ? pin.king.crown.fill : 'none';
      var stroke = (pin.king && pin.king.crown) ? pin.king.crown.stroke : '#9C9A92';
      if (isTop) { fill = '#D9A520'; stroke = '#8A6408'; }
      var dotClass = pin.activeCount > 0 ? 'pin-dot-active' : 'pin-dot-idle';
      // Nobody active: no crown, just "0" and a gray dot.
      var crownHtml = pin.activeCount > 0 ? crownSvg(fill, stroke, 16) : '';
      var label = pin.king ? pin.king.name : pin.name;
      var distanceHtml = miles != null ? '<div class="pin-distance">' + RoyaleGeo.pinDistanceLabel(miles) + '</div>' : '';
      var runHtml = pin.live
        ? '<div class="pin-run"><span class="live-badge">Live</span>' + (pin.nextRun ? ' ' + pin.nextRun.rsvpCount + ' coming' : '') + '</div>'
        : (pin.nextRun
          ? '<div class="pin-run">' + formatRunTimeShort(pin.nextRun.scheduledAt) + ' · ' + pin.nextRun.rsvpCount + ' coming</div>'
          : '');
      return '<div class="kotc-marker-content"><div class="pin' + (isSelected ? ' pin-selected' : '') + (isTop ? ' pin-top' : '') + '">' +
        crownHtml +
        '<span class="pin-count">' + pin.activeCount + '</span>' +
        '<span class="pin-dot ' + dotClass + '"></span>' +
        '</div><div class="pin-label">' + escapeHtml(label) + distanceHtml + runHtml + '</div></div>';
    }

    function openCourtPinHtml(court, miles) {
      var distanceHtml = miles != null ? '<div class="pin-distance">' + RoyaleGeo.pinDistanceLabel(miles) + '</div>' : '';
      return '<div class="kotc-marker-content"><div class="pin pin-open"><span class="pin-dot pin-dot-open"></span></div>' +
        '<div class="pin-label pin-label-open">' + escapeHtml(court.name) +
        '<span class="pin-sub-open">Open court &middot; No king yet</span>' + distanceHtml + '</div></div>';
    }

    var haversineMiles = RoyaleGeo.haversineMiles;

    function showToast(message, ms) {
      var toast = document.getElementById('toast');
      if (!toast) return;
      toast.textContent = message;
      toast.style.display = 'block';
      if (ms) setTimeout(function () { toast.style.display = 'none'; }, ms);
    }

    var map = L.map('map', { zoomControl: true });

    // If the container's layout isn't fully settled yet when Leaflet
    // measures it (e.g. web fonts still loading and about to reflow the
    // page), it caches the wrong size and the map renders small/cramped
    // inside the correctly-sized box. Re-measure once things settle.
    function refreshMapSize() { map.invalidateSize(); }
    window.addEventListener('resize', refreshMapSize);
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(refreshMapSize).catch(function () {});
    }
    setTimeout(refreshMapSize, 300);
    setTimeout(refreshMapSize, 1000);
    RoyaleMap.addBaseLayer(map);

    var parkMarkers = {};
    pins.forEach(function (pin) {
      if (pin.lat == null || pin.lng == null) return;
      var isSelected = pin.id === selectedParkData.id;
      var icon = L.divIcon({ className: 'kotc-marker', html: pinHtml(pin, isSelected), iconSize: [0, 0] });
      var marker = L.marker([pin.lat, pin.lng], { icon: icon })
        .addTo(map)
        .on('click', function () { window.location.href = '/?park=' + pin.id; });
      parkMarkers[pin.id] = marker;
    });

    if (selectedParkData.lat != null) {
      L.circle([selectedParkData.lat, selectedParkData.lng], {
        radius: selectedParkData.checkInRadiusMeters,
        color: '#5B2A86',
        fillColor: '#5B2A86',
        fillOpacity: 0.12,
        weight: 1,
      }).addTo(map);
    }

    // Default center when we don't know the player's own location — this
    // app's real-world home turf, not a computed fit of the seeded parks.
    var FORT_LAUDERDALE = [26.1224, -80.1373];
    function setFallbackView() {
      map.setView(FORT_LAUDERDALE, 12);
    }

    // Updates every park pin's distance label and, for the currently
    // selected park, the bottom sheet's too (including swapping in the
    // "too far to check in" message once we know the real distance).
    // Returns the nearest-with-activity park (falling back to nearest
    // overall) so the caller can decide whether to jump to its sheet.
    // `confident` is false for a rough GPS fix: distances still show, but
    // the Check in button stays, so tapping it can retry for a better
    // signal instead of the page deciding "too far" on a bad reading.
    function updateDistancesAndFindNearest(playerLat, playerLng, confident) {
      var nearest = null;
      pins.forEach(function (pin) {
        if (pin.lat == null || pin.lng == null) return;
        var miles = haversineMiles(playerLat, playerLng, pin.lat, pin.lng);
        var hasActivity = (pin.activeCount + pin.liveCount) > 0;
        var better = !nearest ||
          (hasActivity && !nearest.hasActivity) ||
          (hasActivity === nearest.hasActivity && miles < nearest.miles);
        if (better) nearest = { id: pin.id, miles: miles, hasActivity: hasActivity };

        var marker = parkMarkers[pin.id];
        if (marker) {
          var isSelected = pin.id === selectedParkData.id;
          marker.setIcon(L.divIcon({ className: 'kotc-marker', html: pinHtml(pin, isSelected, miles), iconSize: [0, 0] }));
        }
        if (pin.id === selectedParkData.id) {
          var sheetDistanceEl = document.getElementById('sheetDistance');
          if (sheetDistanceEl) sheetDistanceEl.textContent = RoyaleGeo.distanceLabel(miles);

          var normal = document.getElementById('sheetCheckInNormal');
          var tooFar = document.getElementById('sheetTooFar');
          if (confident && normal && tooFar && miles * 1609.34 > selectedParkData.checkInRadiusMeters) {
            normal.style.display = 'none';
            document.getElementById('sheetTooFarMsg').textContent =
              "You're " + RoyaleGeo.distanceLabel(miles) + '. Check in opens when you get to the court.';
            tooFar.style.display = 'block';
          }
        }
      });
      return nearest;
    }

    var openCourtMarkers = {};
    function loadNearbyOpenCourts(playerLat, playerLng) {
      fetch('/api/nearby-courts?lat=' + playerLat + '&lng=' + playerLng)
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (!data.ok) return;
          data.courts.forEach(function (court) {
            var miles = haversineMiles(playerLat, playerLng, court.lat, court.lng);
            var icon = L.divIcon({ className: 'kotc-marker', html: openCourtPinHtml(court, miles), iconSize: [0, 0] });
            var marker = L.marker([court.lat, court.lng], { icon: icon }).addTo(map);
            marker.on('click', function () { showOpenCourtPanel(court); });
            openCourtMarkers[court.osmId] = marker;
          });
        })
        .catch(function () {});
    }

    function showOpenCourtPanel(court) {
      closeSuggestPanel();
      var panel = document.getElementById('openCourtPanel');
      var nameEl = document.getElementById('openCourtName');
      var checkInBtn = document.getElementById('openCourtCheckIn');
      nameEl.textContent = court.name + ' — open court, no king yet';
      checkInBtn.disabled = false;
      checkInBtn.textContent = 'Check in';
      panel.style.display = 'block';

      var startRunLink = document.getElementById('openCourtStartRun');
      startRunLink.href = '/runs/new?osmId=' + encodeURIComponent(court.osmId) +
        '&name=' + encodeURIComponent(court.name) + '&lat=' + court.lat + '&lng=' + court.lng;

      var followBtn = document.getElementById('openCourtFollow');
      followBtn.disabled = false;
      followBtn.textContent = 'Follow';
      followBtn.onclick = function () {
        followBtn.disabled = true;
        fetch('/open-courts/follow', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ osmId: court.osmId, name: court.name, lat: court.lat, lng: court.lng }),
        })
          .then(function (r) { return r.json(); })
          .then(function (data) {
            followBtn.textContent = data.ok ? 'Following ✓' : 'Follow';
            followBtn.disabled = !data.ok;
          })
          .catch(function () { followBtn.disabled = false; });
      };

      // A fresh reading at the moment of the tap — not the one from when
      // the map loaded, which could be minutes and blocks out of date.
      checkInBtn.onclick = function () {
        checkInBtn.disabled = true;
        RoyaleGeo.checkIn({
          url: '/open-courts/check-in',
          body: function (pos) {
            return {
              osmId: court.osmId, name: court.name, lat: court.lat, lng: court.lng,
              playerLat: pos.coords.latitude, playerLng: pos.coords.longitude,
              accuracy: pos.coords.accuracy,
            };
          },
          onStatus: function (text) { checkInBtn.textContent = text; },
          onDone: function (data) { window.location.href = '/?park=' + data.parkId; },
          onFail: function (message) {
            checkInBtn.disabled = false;
            checkInBtn.textContent = 'Check in';
            nameEl.textContent = message;
          },
        });
      };
    }
    document.getElementById('openCourtCancel').addEventListener('click', function () {
      document.getElementById('openCourtPanel').style.display = 'none';
    });

    // Suggest a court: tap the button, tap the map to drop a pin, name it.
    var suggestMode = false;
    var suggestMarker = null;
    var suggestLatLng = null;
    var suggestPhotoDataUrl = null;
    var suggestBtn = document.getElementById('suggestCourtBtn');
    var suggestPanel = document.getElementById('suggestCourtPanel');
    var suggestNameInput = document.getElementById('suggestCourtName');
    var suggestSubmitBtn = document.getElementById('suggestCourtSubmit');
    var suggestPhotoInput = document.getElementById('suggestCourtPhoto');
    var suggestPhotoPreviewWrap = document.getElementById('suggestCourtPhotoPreviewWrap');
    var suggestPhotoPreview = document.getElementById('suggestCourtPhotoPreview');
    var suggestPhotoError = document.getElementById('suggestCourtPhotoError');
    var SUGGEST_PHOTO_MAX_BYTES = 5 * 1024 * 1024;

    function resetSuggestPhoto() {
      suggestPhotoDataUrl = null;
      suggestPhotoInput.value = '';
      suggestPhotoPreviewWrap.style.display = 'none';
      suggestPhotoPreview.src = '';
      suggestPhotoError.style.display = 'none';
    }

    function closeSuggestPanel() {
      suggestMode = false;
      suggestBtn.classList.remove('active');
      suggestPanel.style.display = 'none';
      suggestNameInput.value = '';
      suggestSubmitBtn.disabled = true;
      if (suggestMarker) { map.removeLayer(suggestMarker); suggestMarker = null; }
      suggestLatLng = null;
      resetSuggestPhoto();
    }

    suggestPhotoInput.addEventListener('change', function () {
      var file = suggestPhotoInput.files[0];
      if (!file) return;
      if (file.type.indexOf('image/') !== 0) {
        suggestPhotoError.textContent = 'Please choose an image file.';
        suggestPhotoError.style.display = 'block';
        suggestPhotoInput.value = '';
        return;
      }
      if (file.size > SUGGEST_PHOTO_MAX_BYTES) {
        suggestPhotoError.textContent = 'That photo is too large (5MB max).';
        suggestPhotoError.style.display = 'block';
        suggestPhotoInput.value = '';
        return;
      }
      suggestPhotoError.style.display = 'none';
      var reader = new FileReader();
      reader.onload = function () {
        suggestPhotoDataUrl = reader.result;
        suggestPhotoPreview.src = suggestPhotoDataUrl;
        suggestPhotoPreviewWrap.style.display = 'block';
      };
      reader.readAsDataURL(file);
    });

    document.getElementById('suggestCourtPhotoRemove').addEventListener('click', resetSuggestPhoto);

    // Where the player is, when the browser knows: lets the server add a park
    // right away if they're standing at the spot.
    var myPos = null;
    if (navigator.geolocation) {
      RoyaleGeo.getPosition(function (pos) { myPos = pos.coords; }, function () {});
    }

    suggestBtn.addEventListener('click', function () {
      if (suggestMode) { closeSuggestPanel(); return; }
      document.getElementById('openCourtPanel').style.display = 'none';
      suggestMode = true;
      suggestBtn.classList.add('active');
      suggestPanel.style.display = 'block';
    });

    map.on('click', function (e) {
      if (!suggestMode) return;
      suggestLatLng = e.latlng;
      if (suggestMarker) map.removeLayer(suggestMarker);
      suggestMarker = L.marker(e.latlng).addTo(map);
      suggestSubmitBtn.disabled = !suggestNameInput.value.trim();
    });

    suggestNameInput.addEventListener('input', function () {
      suggestSubmitBtn.disabled = !(suggestLatLng && suggestNameInput.value.trim());
    });

    document.getElementById('suggestCourtCancel').addEventListener('click', closeSuggestPanel);

    suggestSubmitBtn.addEventListener('click', function () {
      if (!suggestLatLng) return;
      suggestSubmitBtn.disabled = true;
      fetch('/court-suggestions', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: suggestNameInput.value.trim(), lat: suggestLatLng.lat, lng: suggestLatLng.lng,
          myLat: myPos ? myPos.latitude : null, myLng: myPos ? myPos.longitude : null,
          photo: suggestPhotoDataUrl,
        }),
      })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (data.ok) {
            closeSuggestPanel();
            showToast(data.created ? 'Park added. Check in when you play there.' : 'Thanks — sent to the organizers for review.', 3000);
          } else {
            suggestSubmitBtn.disabled = false;
            alert(data.error || 'That park could not be added.');
          }
        })
        .catch(function () { suggestSubmitBtn.disabled = false; });
    });

    var inviteBtn = document.getElementById('inviteBtn');
    if (inviteBtn) {
      inviteBtn.addEventListener('click', function () {
        var parkName = <%- JSON.stringify(sheet.park.name).replace(/</g, '\\u003c') %>;
        var url = window.location.origin + '/parks/' + selectedParkData.id;
        var text = 'Pull up to ' + parkName + ". Let's see who takes the crown.";
        RoyaleTrack.report('invite_friends');
        if (navigator.share) {
          navigator.share({ title: 'Basketball Royale', text: text, url: url }).catch(function () {});
        } else if (navigator.clipboard) {
          navigator.clipboard.writeText(text + ' ' + url).then(function () {
            showToast('Invite link copied to clipboard', 3000);
          });
        } else {
          alert(text + ' ' + url);
        }
      });
    }

    // Show something immediately (geolocation can be slow or never
    // resolve), then re-center on the player once/if it does.
    setFallbackView();
    if (navigator.geolocation) {
      RoyaleGeo.getPosition(function (pos) {
        var youIcon = L.divIcon({
          className: 'kotc-marker',
          html: '<div class="kotc-dot-content"><div class="you-dot"></div><div class="you-label">You</div></div>',
          iconSize: [0, 0],
        });
        L.marker([pos.coords.latitude, pos.coords.longitude], { icon: youIcon, zIndexOffset: 1000 }).addTo(map);
        map.setView([pos.coords.latitude, pos.coords.longitude], 13);

        var nearest = updateDistancesAndFindNearest(pos.coords.latitude, pos.coords.longitude, !RoyaleGeo.isRoughFix(pos));
        var urlHasPark = new URLSearchParams(window.location.search).has('park');
        if (!urlHasPark && nearest && nearest.id !== selectedParkData.id) {
          window.location.href = '/?park=' + nearest.id;
          return;
        }

        loadNearbyOpenCourts(pos.coords.latitude, pos.coords.longitude);
      }, function () {
        // Permission denied or unavailable — keep the fallback view.
        var banner = document.getElementById('locationBanner');
        if (banner) {
          banner.textContent = 'Turn on location to see courts near you.';
          banner.style.display = 'block';
        }
      });
    }
  })();
</script>
<% } %>

<script>
  (function () {
    var parkId = <%= selectedPark ? selectedPark.id : 'null' %>;

    var btn = document.getElementById('homeCheckInBtn');
    if (!btn || btn.disabled) {
      <% if (sheet && sheet.checkedIn) { %>RoyaleGeo.startHeartbeat(parkId);<% } %>
      return;
    }
    btn.addEventListener('click', function () {
      var statusEl = document.getElementById('homeCheckInStatus');
      btn.disabled = true;
      RoyaleGeo.checkIn({
        url: '/parks/' + parkId + '/check-in',
        onStatus: function (text) { statusEl.textContent = text; },
        onDone: function () { location.reload(); },
        onFail: function (message) {
          btn.disabled = false;
          statusEl.textContent = message;
        },
      });
    });
  })();
</script>
</body>
</html>
