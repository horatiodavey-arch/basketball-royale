<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Runs — Basketball Royale</title>
<%- include('partials/fonts') %>
<link rel="stylesheet" href="/style.css">
</head>
<body class="kotc">
<div class="page">
  <%- include('partials/royale-header') %>
  <% if (showIntro) { %><%- include('partials/how-it-works-card', { returnTo: '/runs' }) %><% } %>
  <div class="page-title heading">Runs</div>
  <div class="page-sub">Find a run, follow a court, or start your own &mdash; from anywhere.</div>

  <% if (suggestedParks.length > 0) { %>
    <div class="section">Suggested parks</div>
    <% suggestedParks.forEach((sp) => { %>
      <div class="stats-card suggested-park-card" data-park-id="<%= sp.park.id %>" data-lat="<%= sp.park.lat %>" data-lng="<%= sp.park.lng %>">
        <div class="park-link-with-thumb">
          <%- include('partials/park-thumb', { park: sp.park }) %>
          <div class="park-link-body">
            <div class="stats-label" style="margin-bottom: 2px;"><%- include('partials/park-name', { name: sp.park.name, city: sp.park.city }) %><% if (sp.live) { %><span class="live-badge">Live</span><% } %></div>
            <div class="suggestion-meta">
              <span class="suggested-distance"></span>
              <%= sp.king ? ('King: ' + sp.king.name) : 'No king yet' %>
              <% if (sp.upcomingRuns.length > 0) { %> &middot; Next run <%= formatRunTime(sp.upcomingRuns[0].scheduledAt) %><% } %>
            </div>
          </div>
        </div>
        <div class="declare-row" style="margin-top: 10px;">
          <% if (sp.checkedIn) { %>
            <button type="button" class="small-btn" disabled>Checked in</button>
          <% } else { %>
            <button type="button" class="small-btn suggested-checkin-btn" data-park-id="<%= sp.park.id %>">Check in</button>
          <% } %>
          <form method="POST" action="/courts/<%= sp.firstCourtId %>/next" style="flex: 1;">
            <button type="submit" class="small-btn small-btn-accent" style="width: 100%;" <%= sp.firstCourtId ? '' : 'disabled' %>>I got next</button>
          </form>
        </div>
      </div>
    <% }); %>
  <% } %>

  <% if (followedCourts.length > 0) { %>
    <div class="section">Following</div>
    <% followedCourts.forEach((fc) => { %>
      <a href="/parks/<%= fc.parkId %>" class="park-link">
        <div class="park-link-name"><%- include('partials/park-name', { name: fc.parkName, city: fc.parkCity }) %> &middot; <%= fc.courtName %></div>
        <div class="park-link-location">
          <%= fc.king ? ('King: ' + fc.king.name) : 'No king yet' %>
          <% if (fc.nextRun) { %> &middot; Next run <%= formatRunTime(fc.nextRun.scheduledAt) %><% } %>
        </div>
      </a>
    <% }); %>
  <% } %>

  <% if (cancelledRuns.length > 0) { %>
    <div class="section">Cancelled runs you were coming to</div>
    <% cancelledRuns.forEach((cr) => { %>
      <a class="stats-card" href="/runs/<%= cr.id %>" style="display: block; text-decoration: none; color: inherit;">
        <div class="stats-label"><%= cr.courtName %> &middot; <%= cr.parkName %></div>
        <div class="suggestion-meta">Cancelled &middot; was <%= formatRunTime(cr.scheduledAt) %></div>
      </a>
    <% }); %>
  <% } %>

  <div class="section">Runs near you</div>
  <div id="nearbyRunsLoading" class="next-action-note">Finding runs near you&hellip;</div>
  <div id="nearbyRunsList" style="display: none;"></div>
  <div id="nearbyRunsEmpty" class="empty-board" style="display: none;"></div>
  <div id="nearbyRunsNoLocation" class="next-action-note" style="display: none;">Turn on location to see runs near you.</div>

  <div class="section">Parks</div>
  <% if (parks.length === 0) { %>
    <div class="empty-board">No parks yet.</div>
  <% } else { %>
    <input type="search" id="parkSearch" class="park-search" placeholder="Search parks" autocomplete="off" aria-label="Search parks">
    <% parks.forEach((park) => { %>
      <a href="/parks/<%= park.id %>" class="park-link park-link-with-thumb park-search-item" data-search="<%= [park.name, park.city, park.location].filter(Boolean).join(' ').toLowerCase() %>">
        <%- include('partials/park-thumb', { park: park }) %>
        <div class="park-link-body">
          <div class="park-link-name"><%- include('partials/park-name', { name: park.name, city: park.city }) %><% if (park.isNew) { %><span class="new-badge">New</span><% } %></div>
          <% if (park.live) { %><div class="park-link-location"><span class="live-badge">Live now</span></div><% } %>
          <div class="park-link-location"><%= park.location %></div>
          <% park.courts.forEach((court) => { %>
            <div class="court-format-line"><%= court.name %> &middot; <%= court.label %></div>
          <% }); %>
        </div>
      </a>
    <% }); %>
    <div id="parkSearchEmpty" class="empty-board" style="display: none;">No parks match that search.</div>
  <% } %>

  <div class="season-note" style="text-align: center; margin-top: 18px;">
    Looking for a paid lobby instead? <a href="/lobbies" class="player-link" style="color: var(--accent); font-weight: 600;">View lobbies &rsaquo;</a>
  </div>
  <% if (profile && profile.is_organizer) { %>
    <div class="season-note" style="text-align: center; margin-top: 6px;">
      <a href="/admin/stats" class="player-link" style="color: var(--accent); font-weight: 600;">Organizer &rsaquo;</a>
    </div>
  <% } %>
</div>
<%- include('partials/bottom-nav', { active: 'runs' }) %>

<script src="/geo.js"></script>
<script src="/track.js"></script>
<script>
  (function () {
    function escapeHtml(s) {
      return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    // Type-to-filter over the Parks list: name, city, and address — so
    // "sac" finds Sunrise Athletic Complex (SAC), "sunrise" finds it too.
    var parkSearch = document.getElementById('parkSearch');
    if (parkSearch) {
      parkSearch.addEventListener('input', function () {
        var term = parkSearch.value.trim().toLowerCase();
        var shown = 0;
        document.querySelectorAll('.park-search-item').forEach(function (item) {
          var match = item.getAttribute('data-search').indexOf(term) !== -1;
          item.style.display = match ? '' : 'none';
          if (match) shown += 1;
        });
        document.getElementById('parkSearchEmpty').style.display = shown === 0 ? 'block' : 'none';
      });
    }

    function renderRuns(runs) {
      var list = document.getElementById('nearbyRunsList');
      list.innerHTML = runs.map(function (r) {
        var park = escapeHtml(r.parkName) + (r.parkCity ? ' <span class="park-city">&middot; ' + escapeHtml(r.parkCity) + '</span>' : '');
        var liveTag = r.live ? '<span class="live-badge">Live</span> ' : '';
        return '<a href="/runs/' + r.id + '" class="park-link run-card">' +
          '<div class="park-link-name">' + liveTag + escapeHtml(r.timeLabel) + ' &middot; ' + park + ' (' + escapeHtml(r.courtName) + ')</div>' +
          '<div class="park-link-location">' + r.rsvpCount + ' coming' + (r.note ? ' &middot; ' + escapeHtml(r.note) : '') + '</div>' +
          '</a>';
      }).join('');
      list.style.display = 'block';
    }

    // Live first: a live run nearby beats "create your own", every time.
    function renderEmpty(data) {
      var empty = document.getElementById('nearbyRunsEmpty');
      var court = data.nearestCourt;
      var live = data.liveNearby;
      var html;
      if (live) {
        html = '<div class="empty-state">Nothing live here right now. <strong>' + escapeHtml(live.parkName) + '</strong> is live, ' +
          escapeHtml(RoyaleGeo.pinDistanceLabel(live.distanceMeters / 1609.34)) + ' away.' +
          '<br><a href="/runs/' + live.id + '" class="submit-btn" data-track="empty_view_live_run" style="display: inline-block; margin-top: 10px; text-decoration: none;">View live run</a>' +
          (court ? '<div class="empty-sub">Or <a href="/runs/new?courtId=' + court.id + '" data-track="empty_create_run">create your own run</a>.</div>' : '') +
          '</div>';
      } else if (court) {
        html = '<div class="empty-state">No runs live right now. Create your own run, or follow a park to know when one starts.' +
          '<br><a href="/runs/new?courtId=' + court.id + '" class="submit-btn" data-track="empty_create_run" style="display: inline-block; margin-top: 10px; text-decoration: none;">Create your own run</a>' +
          '<div class="empty-sub"><a href="/parks/' + court.parkId + '" data-track="empty_follow_park">Follow a park</a> to see who is running it.</div></div>';
      } else {
        html = '<div class="empty-state">No runs live right now. Create your own run, or follow a park to know when one starts.</div>';
      }
      empty.innerHTML = html;
      empty.style.display = 'block';
    }

    // Taps on the empty-state links are counted for the admin dashboard.
    document.addEventListener('click', function (e) {
      var tracked = e.target.closest ? e.target.closest('[data-track]') : null;
      if (tracked && window.RoyaleTrack) RoyaleTrack.report(tracked.getAttribute('data-track'));
    });

    function loadNearbyRuns(lat, lng) {
      fetch('/api/nearby-runs?lat=' + lat + '&lng=' + lng)
        .then(function (r) { return r.json(); })
        .then(function (data) {
          document.getElementById('nearbyRunsLoading').style.display = 'none';
          if (!data.ok) return;
          if (data.runs.length > 0) {
            renderRuns(data.runs);
          } else {
            renderEmpty(data);
          }
        })
        .catch(function () {
          document.getElementById('nearbyRunsLoading').style.display = 'none';
        });
    }

    // Reuses the same geolocation fix already gathered for nearby runs —
    // no second permission prompt just to show distance on these cards.
    function fillSuggestedParkDistances(lat, lng) {
      document.querySelectorAll('.suggested-park-card').forEach(function (card) {
        var pLat = parseFloat(card.getAttribute('data-lat'));
        var pLng = parseFloat(card.getAttribute('data-lng'));
        if (isNaN(pLat) || isNaN(pLng)) return;
        var miles = RoyaleGeo.haversineMiles(lat, lng, pLat, pLng);
        var el = card.querySelector('.suggested-distance');
        if (el) el.textContent = RoyaleGeo.distanceLabel(miles) + ' · ';
      });
    }

    document.querySelectorAll('.suggested-checkin-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var originalText = btn.textContent;
        btn.disabled = true;
        RoyaleGeo.checkIn({
          url: '/parks/' + btn.getAttribute('data-park-id') + '/check-in',
          onStatus: function (text) { btn.textContent = text; },
          onDone: function () { location.reload(); },
          onFail: function (message) {
            btn.disabled = false;
            btn.textContent = originalText;
            alert(message);
          },
        });
      });
    });

    // RoyaleGeo.getPosition calls the error handler when the device has
    // no geolocation at all, too — one "no location" path for both.
    RoyaleGeo.getPosition(function (pos) {
      loadNearbyRuns(pos.coords.latitude, pos.coords.longitude);
      fillSuggestedParkDistances(pos.coords.latitude, pos.coords.longitude);
    }, function () {
      document.getElementById('nearbyRunsLoading').style.display = 'none';
      document.getElementById('nearbyRunsNoLocation').style.display = 'block';
    });
  })();
</script>
</body>
</html>
