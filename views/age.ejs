<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Basketball Royale — Your age</title>
<%- include('partials/fonts') %>
<%- include('partials/pwa-head') %>
<link rel="stylesheet" href="/style.css">
</head>
<body>
<div class="phone">
  <%- include('partials/royale-header') %>
  <div class="brand">&#127936; Basketball Royale</div>
  <div class="brand-sub">One quick question.</div>

  <% if (error) { %>
    <div class="error-msg"><%= error %></div>
  <% } %>

  <form method="POST" action="<%= action %>">
    <div class="field">
      <label for="birthYear">What year were you born?</label>
      <select id="birthYear" name="birthYear" class="age-select" required>
        <option value="" selected disabled>Pick a year</option>
        <% years.forEach((y) => { %><option value="<%= y %>"><%= y %></option><% }); %>
      </select>
    </div>
    <button type="submit" class="submit">Continue</button>
  </form>

  <div class="fine" style="margin-top: 14px;">We only keep the year, never your full birthday.</div>
</div>
</body>
</html>
