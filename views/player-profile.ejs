<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= player.name %> — Basketball Royale</title>
<%- include('partials/fonts') %>
<link rel="stylesheet" href="/style.css">
</head>
<body class="kotc">
<div class="page">
  <%- include('partials/royale-header', { trophyNote: true }) %>
  <div class="live-part" data-live-key="header" data-live-url="/live/profile/<%= player.player_id %>" data-live-v="<%= liveVersion %>">
    <%- include('partials/profile-header-live', { player: player, initials: initials, isSelf: isSelf }) %>
  </div>

  <% if (isSelf) { %><span class="lb-you-tag">(You)</span><% } %>
      </div>
      <div class="profile-record"><%= player.wins %>W &ndash; <%= player.losses %>L &middot; <%= player.games_played %> games</div>
    </div>
  </div>

  <% if (isSelf) { %>
    <form method="POST" action="/profile/name" class="settings-form" style="margin-bottom: 14px;">
      <div class="form-group">
        <label for="displayName">Display name</label>
        <input type="text" id="displayName" name="name" value="<%= player.base_name %>" maxlength="30" required>
      </div>
      <button type="submit" class="small-btn">Save name</button>
      <% if (nameError) { %><div class="error-msg" style="margin-top: 8px;"><%= nameError %></div><% } %>
    </form>
  <% } %>
  <div class="live-part" data-live-key="body">
    <%- include('partials/profile-body-live', { crown: crown, points: points, formats: formats, season: season, trophies: trophies, ladder: ladder, perks: perks }) %>
  </div>
</div>
<%- include('partials/bottom-nav', { active: 'profile' }) %>
<script src="/live.js"></script>
</body>
</html>
