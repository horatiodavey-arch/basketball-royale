<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= player.name %> — Basketball Royale</title>
<%- include('partials/fonts') %>
<link rel="stylesheet" href="/style.css">
</head>
<body class="kotc">
<div class="page">
  <div class="profile-header">
    <div class="avatar profile-avatar"><%= initials %></div>
    <div class="profile-id">
      <div class="profile-name heading">
        <%= player.name %>
        <% if (isSelf) { %><span class="lb-you-tag">(You)</span><% } %>
      </div>
      <div class="profile-record"><%= player.wins %>W &ndash; <%= player.losses %>L &middot; <%= player.games_played %> games</div>
    </div>
  </div>

  <div class="profile-crown-card">
    <%- include('partials/crown-icon', { size: 30, fill: crown ? crown.fill : 'none', stroke: crown ? crown.stroke : 'var(--muted)' }) %>
    <div class="profile-crown-main">
      <div class="profile-crown-level"><%= crown ? crown.name : (perks[0].pointsNeeded + ' pts to a crown') %></div>
      <div class="profile-crown-points"><%= points %> pts this season</div>
    </div>
  </div>
  <div class="season-note">Resets in <%= season.daysLeft %> day<%= season.daysLeft === 1 ? '' : 's' %>.</div>

  <div class="section">Crown perks</div>
  <% perks.forEach((perk) => { %>
    <div class="perk-row <%= perk.earned ? 'earned' : 'locked' %>">
      <div class="perk-icon">
        <% if (perk.earned) { %>
          <%- include('partials/crown-icon', { size: 26, fill: perk.fill, stroke: perk.stroke }) %>
        <% } else { %>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--muted)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
        <% } %>
      </div>
      <div class="perk-main">
        <div class="perk-name"><%= perk.name %></div>
        <div class="perk-desc"><%= perk.description %></div>
      </div>
      <div class="perk-status">
        <% if (perk.earned) { %>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--green-text)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        <% } else { %>
          <span class="perk-hint"><%= perk.lockedHint %></span>
        <% } %>
      </div>
    </div>
  <% }); %>
</div>
<%- include('partials/bottom-nav', { active: 'profile' }) %>
</body>
</html>
