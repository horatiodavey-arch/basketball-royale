<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= player.name %> — Basketball Royale</title>
<%- include('partials/fonts') %>
<link rel="stylesheet" href="/style.css">
</head>
<body class="kotc profile-page">
<div class="page">
  <%- include('partials/royale-header', { trophyNote: true }) %>

  <div class="live-part" data-live-key="header" data-live-url="/live/profile/<%= player.player_id %>" data-live-v="<%= liveVersion %>">
    <%- include('partials/profile-header-live', { player: player, initials: initials, tierLabel: tierLabel }) %>
  </div>

  <div class="live-part" data-live-key="body">
    <%- include('partials/profile-body-live', { kingRows: kingRows, trophyCount: trophyCount, trophyByFormat: trophyByFormat, gamesThisSeason: gamesThisSeason, topBreakdown: topBreakdown, badges: badges }) %>
  </div>

  <% if (isSelf) { %>
    <details class="pf-details" <%= nameError ? 'open' : '' %>>
      <summary class="pf-details-summary">Edit display name</summary>
      <form method="POST" action="/profile/name" class="settings-form" style="margin-top: 10px;">
        <div class="form-group">
          <label for="displayName">Display name</label>
          <input type="text" id="displayName" name="name" value="<%= player.base_name %>" maxlength="30" required>
        </div>
        <button type="submit" class="small-btn">Save name</button>
        <% if (nameError) { %><div class="error-msg" style="margin-top: 8px;"><%= nameError %></div><% } %>
      </form>
    </details>
  <% } %>
  <% if (isSelf && inviteTag) { %>
    <div class="invite-line">Know someone who hoops? Bring them in.</div>
    <button type="button" id="inviteHooperBtn" class="small-btn pf-invite">Invite a hooper</button>
    <div class="invite-line"><a href="/how-it-works?from=profile" class="player-link" style="color: var(--accent); font-weight: 600;">How it works &rsaquo;</a></div>
    <script src="/track.js"></script>
    <script>
      (function () {
        var link = '/?ref=<%= inviteTag %>';
        document.getElementById('inviteHooperBtn').addEventListener('click', function () {
          var url = window.location.origin + link;
          RoyaleTrack.report('invite_friends');
          if (navigator.clipboard) {
            navigator.clipboard.writeText(url).then(function () {
              alert('Invite link copied to clipboard');
            }, function () { alert(url); });
          } else {
            alert(url);
          }
        });
      })();
    </script>
  <% } %>
</div>
<%- include('partials/bottom-nav', { active: 'profile' }) %>
<script src="/live.js"></script>
</body>
</html>
